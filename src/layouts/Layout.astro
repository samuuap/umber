---
import { Font } from 'astro:assets';

import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { THEME_COOKIE, parseTheme } from '@/lib/theme';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** La imagen al compartir el enlace (Open Graph), absoluta. Sin ella, la de Umber. */
  image?: string | null;
  /** El chat lo quita: su compositor ocupa el pie de la pantalla. */
  footer?: boolean;
}

const {
  title = 'Umber — tu cinéfilo de confianza',
  description = 'Cuéntale a Umber cómo estás y qué te gusta, y te recomienda la película o la serie que encaja, con el porqué y dónde verla.',
  image = null,
  footer = true,
} = Astro.props;
// Sin los filtros ni el `q` de la URL: la misma página para los buscadores.
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const shareImage = image ?? new URL('/og.png', Astro.url.origin).href;
// Sin cookie, el del sistema (CSS); con ella, el que eligió con el botón de la cabecera.
const theme = parseTheme(Astro.cookies.get(THEME_COOKIE)?.value);
---

<!doctype html>
<html lang="es" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content={theme ?? 'light dark'} />
    <meta name="theme-color" content="#f3eee5" media={theme === 'dark' ? 'not all' : theme === 'light' ? undefined : '(prefers-color-scheme: light)'} />
    <meta name="theme-color" content="#14110e" media={theme === 'light' ? 'not all' : theme === 'dark' ? undefined : '(prefers-color-scheme: dark)'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Umber" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- La vista previa al compartir el enlace (WhatsApp, redes, mensajería) -->
    <meta property="og:site_name" content="Umber" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-archivo-narrow" preload />
    {/* Sin precarga: solo la descargan las páginas que la usan (el chat, las fichas). */}
    <Font cssVariable="--font-newsreader-text" />
  </head>
  <body class="flex flex-col">
    <a
      href="#contenido"
      class="bg-umber-accent text-umber-base sr-only z-[70] px-4 py-2 text-sm font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Saltar al contenido
    </a>
    <SiteHeader />
    <div id="contenido" class="flex flex-1 flex-col">
      <slot />
    </div>
    {footer && <SiteFooter />}
    <script>
      import '@/scripts/transitions';
      import '@/scripts/theme';
    </script>
  </body>
</html>
