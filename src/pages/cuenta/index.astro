---
/**
 * `/cuenta` — cambiar nombre de usuario, email y contraseña, elegir «Mis
 * plataformas» y retirar el consentimiento del chat. Formularios independientes (campo oculto `action`),
 * cada uno con su propio error y aviso de éxito.
 *
 * Cambiar el email manda confirmación (y, según la configuración del proyecto,
 * también desde el email actual: «Secure email change») antes de aplicarse.
 */
import PlatformPicker from '@/components/PlatformPicker.astro';
import Layout from '@/layouts/Layout.astro';
import {
  MAX_PASSWORD_CHARS,
  MIN_PASSWORD_CHARS,
  USERNAME_INPUT_PATTERN,
  USERNAME_PATTERN,
  authErrorMessage,
  isUsernameTaken,
  normalizeUsername,
  type AuthFormError,
} from '@/lib/auth';
import { AI_CONSENT_COOKIE, AI_CONSENT_VERSION, hasAiConsent } from '@/lib/legal';
import { regionFromAcceptLanguage } from '@/lib/locale';
import { platformCounts } from '@/lib/platforms';
import { TMDB_DEFAULT_REGION } from '@/lib/tmdb';

if (Astro.locals.user === null) return Astro.redirect('/entrar?next=%2Fcuenta');
const user = Astro.locals.user;

let usernameValue = user.username ?? '';
let usernameError: AuthFormError | null = null;
let usernameDone = false;

let emailValue = user.email ?? '';
let emailError: AuthFormError | null = null;
let emailSentTo: string | null = null;

let passwordError: AuthFormError | null = null;
let passwordDone = false;

/** El de la cuenta o, si no, el de este navegador (de antes de guardarse en la cuenta). */
let consented = hasAiConsent(Astro.cookies.get(AI_CONSENT_COOKIE)?.value, user.aiConsent);
let consentWithdrawn = false;
let consentError: string | null = null;

/** Las de su región, de más a menos títulos: lo que se puede marcar. */
const platforms = await platformCounts(
  regionFromAcceptLanguage(Astro.request.headers.get('accept-language')) ?? TMDB_DEFAULT_REGION,
  null,
);
let myPlatforms = user.platforms;
let platformsDone = false;
let platformsError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (name: string): string => {
    const value = form.get(name);
    return typeof value === 'string' ? value : '';
  };
  const action = text('action');

  if (action === 'username') {
    usernameValue = normalizeUsername(text('username'));
    if (!USERNAME_PATTERN.test(usernameValue)) {
      usernameError = {
        message: 'De 3 a 20 caracteres: letras sin tilde, números o guion bajo.',
        field: 'username',
      };
    } else {
      const { error } = await Astro.locals.supabase.auth.updateUser({ data: { username: usernameValue } });
      if (error === null) {
        usernameDone = true;
      } else {
        usernameError = (await isUsernameTaken(Astro.locals.supabase, usernameValue))
          ? { message: 'Ese nombre de usuario ya está cogido. Prueba con otro.', field: 'username' }
          : { message: authErrorMessage(error), field: null };
      }
    }
  } else if (action === 'email') {
    emailValue = text('email').trim();
    if (emailValue.length === 0) {
      emailError = { message: 'Escribe el email nuevo.', field: 'email' };
    } else {
      const redirectTo = `${Astro.url.origin}/auth/confirm?next=${encodeURIComponent('/cuenta')}`;
      const { error } = await Astro.locals.supabase.auth.updateUser({ email: emailValue }, { emailRedirectTo: redirectTo });
      if (error === null) {
        emailSentTo = emailValue;
      } else {
        emailError = { message: authErrorMessage(error), field: null };
      }
    }
  } else if (action === 'password') {
    const password = text('password');
    const passwordConfirm = text('password_confirm');
    if (password.length < MIN_PASSWORD_CHARS) {
      passwordError = {
        message: `La contraseña necesita al menos ${String(MIN_PASSWORD_CHARS)} caracteres.`,
        field: 'password',
      };
    } else if (password.length > MAX_PASSWORD_CHARS) {
      passwordError = {
        message: `La contraseña puede tener como mucho ${String(MAX_PASSWORD_CHARS)} caracteres.`,
        field: 'password',
      };
    } else if (password !== passwordConfirm) {
      passwordError = { message: 'Las contraseñas no coinciden.', field: 'password_confirm' };
    } else {
      const { error } = await Astro.locals.supabase.auth.updateUser({ password });
      if (error === null) {
        passwordDone = true;
      } else {
        passwordError = { message: authErrorMessage(error), field: null };
      }
    }
  } else if (action === 'platforms') {
    // Solo las que existen; todas o ninguna es no guardar ninguna: el chat las propone todas.
    const picked = form.getAll('platform').filter(
      (name): name is string => typeof name === 'string' && platforms.some((platform) => platform.name === name),
    );
    const next = picked.length === 0 || picked.length === platforms.length ? null : picked;
    const { error } = await Astro.locals.supabase.auth.updateUser({ data: { platforms: next } });
    if (error === null) {
      // Para que los claims de la sesión (de donde las lee `/chat`) lleven ya las nuevas.
      await Astro.locals.supabase.auth.refreshSession();
      myPlatforms = next;
      platformsDone = true;
    } else {
      platformsError = authErrorMessage(error);
    }
  } else if (action === 'ai_consent_withdraw') {
    // Retirarlo (art. 7.3 RGPD): de la cuenta y de este navegador. Sin él, `/chat` vuelve a pedirlo.
    const { error } = await Astro.locals.supabase.auth.updateUser({ data: { ai_consent: null } });
    if (error === null) {
      await Astro.locals.supabase.auth.refreshSession();
      Astro.cookies.delete(AI_CONSENT_COOKIE, { path: '/' });
      consented = false;
      consentWithdrawn = true;
    } else {
      consentError = authErrorMessage(error);
    }
  }
  if (
    usernameError !== null ||
    emailError !== null ||
    passwordError !== null ||
    consentError !== null ||
    platformsError !== null
  ) {
    Astro.response.status = 400;
  }
}

const inputClass = 'field text-[1.05rem]';
const consentDate =
  user.aiConsent?.version === AI_CONSENT_VERSION
    ? new Date(user.aiConsent.accepted_at).toLocaleDateString('es-ES', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'Europe/Madrid',
      })
    : null;
---

<Layout title="Tu cuenta — Umber">
  <main class="mx-auto w-full max-w-md flex-1 px-5 pt-8 pb-16 sm:px-8 lg:pt-10">
    <p class="eyebrow eyebrow-rule rise">Tu cuenta</p>
    <h1 class="display-1 rise mt-7 [animation-delay:80ms]">Ajustes</h1>

    <section class="border-umber-line mt-12 border-t pt-8">
      <h2 class="font-display text-xl">Nombre de usuario</h2>
      {
        usernameDone && (
          <p role="status" class="text-umber-accent mt-3 text-sm">Nombre actualizado.</p>
        )
      }
      {
        usernameError !== null && usernameError.field === null && (
          <p role="alert" class="mt-3 text-sm text-umber-danger">{usernameError.message}</p>
        )
      }
      <form method="post" class="mt-5 space-y-3">
        <input type="hidden" name="action" value="username" />
        <label for="username" class="sr-only">Nombre de usuario</label>
        <input
          id="username"
          name="username"
          type="text"
          autocomplete="nickname"
          autocapitalize="none"
          spellcheck="false"
          required
          minlength={3}
          maxlength={20}
          pattern={USERNAME_INPUT_PATTERN}
          value={usernameValue}
          aria-invalid={usernameError?.field === 'username' ? 'true' : undefined}
          class={inputClass}
        />
        {
          usernameError?.field === 'username' && (
            <p role="alert" class="text-xs text-umber-danger">{usernameError.message}</p>
          )
        }
        <button type="submit" class="btn-secondary py-2.5 text-sm">Guardar</button>
      </form>
    </section>

    <section class="border-umber-line mt-10 border-t pt-8">
      <h2 class="font-display text-xl">Email</h2>
      <p class="text-umber-muted mt-2 text-sm">
        Al cambiarlo te mandamos un enlace de confirmación al nuevo email; puede que también te pidamos
        confirmarlo desde el actual.
      </p>
      {
        emailSentTo !== null && (
          <p role="status" class="text-umber-accent mt-3 text-sm">
            Revisa <strong class="text-umber-ink font-medium">{emailSentTo}</strong> para confirmar el cambio.
          </p>
        )
      }
      {
        emailError !== null && emailError.field === null && (
          <p role="alert" class="mt-3 text-sm text-umber-danger">{emailError.message}</p>
        )
      }
      <form method="post" class="mt-5 space-y-3">
        <input type="hidden" name="action" value="email" />
        <label for="new_email" class="sr-only">Email nuevo</label>
        <input
          id="new_email"
          name="email"
          type="email"
          autocomplete="email"
          required
          value={emailValue}
          aria-invalid={emailError?.field === 'email' ? 'true' : undefined}
          class={inputClass}
        />
        {
          emailError?.field === 'email' && (
            <p role="alert" class="text-xs text-umber-danger">{emailError.message}</p>
          )
        }
        <button type="submit" class="btn-secondary py-2.5 text-sm">Cambiar email</button>
      </form>
    </section>

    <section class="border-umber-line mt-10 border-t pt-8">
      <h2 class="font-display text-xl">Contraseña</h2>
      {
        passwordDone && (
          <p role="status" class="text-umber-accent mt-3 text-sm">Contraseña actualizada.</p>
        )
      }
      {
        passwordError !== null && passwordError.field === null && (
          <p role="alert" class="mt-3 text-sm text-umber-danger">{passwordError.message}</p>
        )
      }
      <form method="post" class="mt-5 space-y-3">
        <input type="hidden" name="action" value="password" />
        {/* Para el gestor de contraseñas: a qué cuenta corresponde la contraseña nueva. */}
        <input type="email" name="account_email" autocomplete="username" value={user.email ?? ''} hidden readonly />
        <div class="space-y-1.5">
          <label for="password" class="field-label">Contraseña nueva</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            required
            minlength={MIN_PASSWORD_CHARS}
            maxlength={MAX_PASSWORD_CHARS}
            aria-invalid={passwordError?.field === 'password' ? 'true' : undefined}
            class={inputClass}
          />
          {
            passwordError?.field === 'password' && (
              <p role="alert" class="text-xs text-umber-danger">{passwordError.message}</p>
            )
          }
        </div>
        <div class="space-y-1.5">
          <label for="password_confirm" class="field-label">Repite la contraseña</label>
          <input
            id="password_confirm"
            name="password_confirm"
            type="password"
            autocomplete="new-password"
            required
            aria-invalid={passwordError?.field === 'password_confirm' ? 'true' : undefined}
            class={inputClass}
          />
          {
            passwordError?.field === 'password_confirm' && (
              <p role="alert" class="text-xs text-umber-danger">{passwordError.message}</p>
            )
          }
        </div>
        <button type="submit" class="btn-secondary py-2.5 text-sm">Cambiar contraseña</button>
      </form>
    </section>

    {
      platforms.length > 0 && (
        <section id="plataformas" class="border-umber-line mt-10 border-t pt-8">
          <h2 class="font-display text-xl">Mis plataformas</h2>
          <p class="text-umber-muted mt-2 text-sm leading-relaxed">
            Las que tienes. Al empezar una conversación vendrán marcadas, y Umber solo te recomendará lo que esté en
            ellas; ahí mismo puedes cambiarlas si estás en otra casa.
          </p>
          {platformsDone && (
            <p role="status" class="text-umber-accent mt-3 text-sm">
              Plataformas guardadas.
            </p>
          )}
          {platformsError !== null && (
            <p role="alert" class="mt-3 text-sm text-umber-danger">
              {platformsError}
            </p>
          )}
          <form method="post" class="mt-5">
            <input type="hidden" name="action" value="platforms" />
            <PlatformPicker
              platforms={platforms}
              checked={myPlatforms ?? []}
              legend="Mis plataformas"
              unit="títulos"
            />
            <button type="submit" class="btn-secondary mt-5 py-2.5 text-sm">
              Guardar
            </button>
          </form>
        </section>
      )
    }

    <section class="border-umber-line mt-10 border-t pt-8">
      <h2 class="font-display text-xl">El chat y DeepSeek</h2>
      {consentWithdrawn && <p role="status" class="text-umber-accent mt-3 text-sm">Consentimiento retirado.</p>}
      {consentError !== null && <p role="alert" class="mt-3 text-sm text-umber-danger">{consentError}</p>}
      {
        consented ? (
          <>
            <p class="text-umber-muted mt-2 text-sm leading-relaxed">
              Aceptaste{consentDate !== null && ` el ${consentDate}`} que DeepSeek trate en China tus mensajes del
              chat. Si lo retiras, te lo volveremos a pedir antes de abrir el chat.
            </p>
            <form method="post" class="mt-4">
              <input type="hidden" name="action" value="ai_consent_withdraw" />
              <button type="submit" class="btn-secondary py-2.5 text-sm">Retirar el consentimiento</button>
            </form>
          </>
        ) : (
          <p class="text-umber-muted mt-2 text-sm leading-relaxed">
            No has aceptado que DeepSeek trate tus mensajes en China. Te lo pediremos antes de abrir el chat; el resto
            de Umber funciona sin él. <a href="/antes-de-hablar" class="link">Qué significa</a>
          </p>
        )
      }
    </section>

    <section class="border-umber-line mt-10 border-t pt-8">
      <h2 class="font-display text-xl">Tus datos</h2>
      <p class="text-umber-muted mt-2 text-sm">
        Descarga una copia de tu cuenta, tus conversaciones y tus favoritos.
      </p>
      <a href="/api/account/export" class="link mt-4 inline-block text-sm" download>
        Descargar tus datos
      </a>
    </section>

    <section class="mt-10 border-t border-umber-danger/30 pt-8">
      <h2 class="font-display text-xl text-umber-danger">Borrar la cuenta</h2>
      <p class="text-umber-muted mt-2 text-sm">
        Borra tu cuenta, tus conversaciones y tus favoritos. No se puede deshacer.
      </p>
      <a href="/cuenta/borrar" class="mt-4 inline-block text-sm text-umber-danger underline decoration-1 underline-offset-[5px] hover:text-umber-danger">
        Borrar mi cuenta
      </a>
    </section>
  </main>
</Layout>
