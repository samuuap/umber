---
/**
 * Portada: una sala de cine. Arriba, la pantalla: el fotograma de una película
 * muy conocida a sangre, que se abre como un proyector, y encima la acción
 * primero. Se escribe cómo te sientes, se elige película o serie, y el chat
 * empieza con ese mensaje (`/chat?mode=…&q=…`, un formulario GET que funciona
 * sin JavaScript), con las sugerencias debajo.
 *
 * Después, cómo funciona en tres actos, una frase de Umber como la cartela del
 * cine mudo, «Si te gustó…» (los parecidos de la película de la pantalla), el
 * apartado de la especialidad de otoño y el de los juegos. Es la estética «La
 * sala a oscuras» (ver Estética en CLAUDE.md).
 *
 * Umber es general (Fase 8): el ejemplo es una película muy conocida y sus
 * parecidos, y el otoño tiene su propio apartado.
 */
import LeafMark from '@/components/LeafMark.astro';
import Layout from '@/layouts/Layout.astro';
import { errorMessage } from '@/lib/errors';
import { EXPLORE_PATH } from '@/lib/explore';
import { gameDay, loadDailyGame, posterImagePath } from '@/lib/games';
import { RECOMMENDATIONS_PER_DAY } from '@/lib/rate-limit';
import { pickAutumn, pickKnown, pickRelated, pickStill, type ShowcaseTitle } from '@/lib/showcase';
import { backdropUrl, posterUrl } from '@/lib/tmdb';
import { CHAT_MODES, CHAT_MODE_DEFINITIONS, MAX_MESSAGE_CHARS } from '@/lib/types';

const INDEX_SIZE = 6;
/** Con menos parecidos conocidos, el índice no dice «Si te gustó…»: son seis conocidas. */
const MIN_RELATED = 4;

/** El cartel de hoy, en su primer desenfoque: lo mismo que se ve al empezar a jugar. Es ambiente. */
async function loadGames(): Promise<{ posterTeaser: string | null; posterNumber: number | null; titleNumber: number | null }> {
  try {
    const day = gameDay();
    const [poster, title] = await Promise.all([loadDailyGame('poster', day), loadDailyGame('title', day)]);
    return {
      posterTeaser: poster === null ? null : await posterImagePath('poster', day, 0),
      posterNumber: poster?.number ?? null,
      titleNumber: title?.number ?? null,
    };
  } catch (error: unknown) {
    console.warn('[portada] Sin juegos:', errorMessage(error));
    return { posterTeaser: null, posterNumber: null, titleNumber: null };
  }
}

const still = await pickStill();
const [related, autumn, games] = await Promise.all([
  still === null ? Promise.resolve([]) : pickRelated(still.id, INDEX_SIZE),
  pickAutumn(3),
  loadGames(),
]);
const indexIsRelated = still !== null && related.length >= MIN_RELATED;
const index = indexIsRelated ? related : await pickKnown(INDEX_SIZE, still?.id ?? null);

const SUGGESTIONS = [
  'Algo lento y con mucha atmósfera',
  'Una comedia para reírme sin pensar',
  'Un thriller que no me deje respirar',
] as const;

const STEPS = [
  { title: 'Cuéntale cómo estás', text: 'Con tus palabras: tu ánimo, con quién la vas a ver, algo que te encantó.' },
  { title: 'Te pregunta lo justo', text: 'Unas preguntas cortas para afinar. Si tienes prisa, dile que te recomiende ya.' },
  { title: 'Te recomienda una', text: 'Te explica por qué esa y no otra, y en qué plataforma está.' },
] as const;
const ACTS = ['I', 'II', 'III'] as const;

const upcoming = CHAT_MODES.filter((mode) => !CHAT_MODE_DEFINITIONS[mode].available).map(
  (mode) => CHAT_MODE_DEFINITIONS[mode],
);
const signedIn = Astro.locals.user !== null;
const credit = (item: ShowcaseTitle): string =>
  [item.director, item.year].filter((part) => part !== null).join(', ');

// La fecha, como en la cartelera de un cine. El día de Madrid, como el de los juegos.
const today = new Intl.DateTimeFormat('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'Europe/Madrid',
}).format(new Date());
const todayLabel = today.charAt(0).toUpperCase() + today.slice(1);

const stillHref = still === null ? null : `${EXPLORE_PATH}/${still.id}`;
const backdrop = still?.backdrop_path ?? null;
/** El fondo del apartado de otoño: el fotograma de una de sus tres películas. */
const autumnStill = autumn.find((item) => item.backdrop_path !== null) ?? null;

/** Las tres de otoño, montadas en escalera. */
const AUTUMN_POSITIONS = [
  'left-0 top-10 w-[38%]',
  'left-[30%] top-0 z-10 w-[40%]',
  'right-0 top-16 w-[36%]',
] as const;

/** Un título con dos de las cuatro letras destapadas: lo que se ve tras elegirlas. */
const SAMPLE = ['', 'A', '', 'E', '', 'A', ''] as const;
---

<Layout overlay>
  <main class="flex-1">
    {/* ── La pantalla ─────────────────────────────────────────────────────── */}
    <section
      aria-labelledby="portada"
      class="screen under-header relative isolate flex min-h-[100svh] flex-col lg:min-h-[max(44rem,min(100svh,62rem))]"
    >
      {
        backdrop !== null && (
          <div class="shutter absolute inset-x-0 top-0 -z-10 h-[58svh] sm:h-[72svh] lg:inset-y-0 lg:h-auto" aria-hidden="true">
            <div class="ken-burns absolute inset-0">
              <img
                src={backdropUrl(backdrop, 'w1280')}
                srcset={`${backdropUrl(backdrop, 'w780')} 780w, ${backdropUrl(backdrop, 'w1280')} 1280w`}
                sizes="100vw"
                alt=""
                fetchpriority="high"
                class="graded develop size-full object-cover object-[50%_35%]"
              />
            </div>
            <div class="vignette absolute inset-0" />
            {/* Arriba, para que la cabecera se lea; abajo, se funde con la sala. */}
            <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-black/75 to-transparent" />
            <div class="from-umber-base via-umber-base/75 absolute inset-x-0 bottom-0 h-3/4 bg-gradient-to-t to-transparent lg:h-2/3" />
            <div class="from-umber-base/90 via-umber-base/45 absolute inset-y-0 left-0 hidden w-3/4 bg-gradient-to-r to-transparent lg:block" />
          </div>
        )
      }

      {
        still !== null && stillHref !== null && (
          <p class="rise absolute top-[calc(var(--header-h)+1rem)] right-5 max-w-[60%] text-right text-xs [text-shadow:0_1px_14px_rgb(0_0_0/0.9)] [animation-delay:1100ms] sm:right-8 lg:hidden">
            <span class="eyebrow text-umber-ink/85 block text-[0.65rem]">En pantalla</span>
            <a href={stillHref} class="font-display text-umber-ink/90 mt-1 block text-[0.95rem] font-semibold tracking-[-0.01em]">
              {still.title}
            </a>
          </p>
        )
      }

      <div
        class="relative mx-auto grid w-full max-w-[80rem] flex-1 grid-cols-1 content-end gap-y-10 px-5 pt-[calc(var(--header-h)+27svh)] pb-14 sm:px-8 sm:pt-[calc(var(--header-h)+40svh)] lg:grid-cols-12 lg:gap-x-10 lg:pt-[calc(var(--header-h)+4rem)] lg:pb-14"
      >
        <div class="min-w-0 lg:col-span-7">
          <p class="eyebrow eyebrow-rule rise [animation-delay:200ms]">{todayLabel} · Tu cinéfilo de confianza</p>
          <h1 id="portada" class="display-1 mt-5 lg:mt-6 lg:text-[clamp(5rem,7.6vw,8rem)]">
            <span class="sr-only">¿Qué te apetece ver hoy?</span>
            <span class="focus-words" aria-hidden="true">
              <span>¿Qué</span> <span>te</span> <span>apetece</span> <span>ver</span> <span>hoy?</span>
            </span>
          </h1>
          <p class="lead text-umber-ink/80 rise mt-6 max-w-[33rem] [animation-delay:550ms] lg:mt-7">
            Cuéntale a Umber cómo estás y qué te gusta. Te hará unas preguntas y te recomendará una película o una
            serie, con el porqué y dónde verla.
          </p>

          <form
            id="portada-chat"
            action="/chat"
            method="get"
            data-home-composer
            class="composer composer-glass rise mt-8 max-w-[38rem] [animation-delay:650ms] lg:mt-9"
          >
            <fieldset class="tabs px-5 pt-4 sm:px-6">
              <legend class="sr-only">¿Película o serie?</legend>
              <span aria-hidden="true" class="text-umber-muted pb-1.5 text-sm">Busco</span>
              <label>
                <input type="radio" name="mode" value="movie" checked class="sr-only" />
                <span class="tab">una película</span>
              </label>
              <label>
                <input type="radio" name="mode" value="tv" class="sr-only" />
                <span class="tab">una serie</span>
              </label>
            </fieldset>
            <label for="mensaje-portada" class="sr-only">Cuéntale a Umber cómo te sientes</label>
            <textarea
              id="mensaje-portada"
              name="q"
              rows="2"
              maxlength={MAX_MESSAGE_CHARS}
              required
              placeholder="Escribe aquí cómo estás o qué te apetece. Por ejemplo: algo ligero para ver en pareja esta noche…"
              class="placeholder:text-umber-muted block min-h-[7.25rem] w-full resize-none bg-transparent px-5 pt-3 pb-3 font-serif text-[1.15rem] leading-relaxed focus:outline-none sm:min-h-[5.5rem] sm:px-6 sm:text-[1.2rem]"
            ></textarea>
            <div class="border-umber-line flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t px-5 py-3.5 sm:px-6">
              <p class="text-umber-muted text-xs">
                {signedIn ? 'Tus conversaciones se guardan en tu cuenta.' : `Con una cuenta gratis: ${String(RECOMMENDATIONS_PER_DAY)} recomendaciones al día.`}
              </p>
              <button type="submit" class="btn-primary ml-auto">
                Pedir recomendación <span class="arrow" aria-hidden="true">→</span>
              </button>
            </div>
          </form>

          <div aria-labelledby="sugerencias" role="group" class="rise mt-7 max-w-[38rem] [animation-delay:750ms]">
            <p id="sugerencias" class="eyebrow">O empieza por aquí</p>
            <ul class="rail -mx-5 mt-4 gap-2 px-5 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:[mask-image:none]">
              {
                SUGGESTIONS.map((suggestion) => (
                  <li>
                    {/* Fuera del cuadro pero de su formulario (`form`). `formnovalidate`: el cuadro puede ir vacío. */}
                    <button
                      form="portada-chat"
                      type="submit"
                      name="q"
                      value={suggestion}
                      formnovalidate
                      class="chip composer-glass whitespace-nowrap"
                    >
                      {suggestion}
                    </button>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        {
          /* Al pie de la primera pantalla, no de la sección: más alta que la ventana, lo dejaba fuera sin scroll. */
          still !== null && stillHref !== null && (
            <div class="rise absolute top-0 right-8 hidden h-[min(100svh,100%)] w-[min(22%,18rem)] flex-col justify-end pb-14 text-right [animation-delay:1100ms] lg:flex">
              <p class="eyebrow">En pantalla</p>
              <a href={stillHref} class="arrow-host group mt-3 block">
                <span class="font-display group-hover:text-umber-accent block text-[1.6rem] leading-[1.1] font-semibold tracking-[-0.03em] transition-colors">
                  {still.title}
                </span>
                <span class="text-umber-muted mt-2 block text-sm">
                  {credit(still)} <span class="arrow ml-1" aria-hidden="true">→</span>
                </span>
              </a>
            </div>
          )
        }
      </div>
    </section>

    {/* ── Cómo funciona, en tres actos ───────────────────────────────────── */}
    <section aria-labelledby="como-funciona" class="mx-auto w-full max-w-[80rem] px-5 py-24 sm:px-8 lg:py-36">
      <div class="reveal max-w-3xl">
        <p class="eyebrow eyebrow-rule">Cómo funciona</p>
        <h2 id="como-funciona" class="display-2 mt-6">Como hablar con alguien que ha visto mucho cine.</h2>
      </div>
      <ol class="mt-16 grid gap-y-12 md:grid-cols-3 md:gap-x-10 lg:mt-20">
        {
          STEPS.map((step, position) => (
            <li class="reveal border-umber-line border-t pt-6 md:pt-8">
              <p class="eyebrow">Acto {ACTS[position]}</p>
              <h3 class="font-display mt-3 text-[1.45rem] leading-tight tracking-[-0.025em] sm:text-[1.7rem]">{step.title}</h3>
              <p class="text-umber-muted mt-2 max-w-xs leading-relaxed">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {/* ── La cartela: así habla Umber ────────────────────────────────────── */}
    <section aria-label="Cómo habla Umber" class="mx-auto w-full max-w-[80rem] px-5 sm:px-8">
      <figure class="screen intertitle reveal bg-umber-screen mx-auto max-w-5xl px-7 py-16 text-center sm:px-16 sm:py-24">
        <LeafMark class="text-umber-accent mx-auto size-6" />
        <blockquote class="mx-auto mt-8 max-w-3xl font-serif text-[clamp(1.7rem,3.5vw,2.9rem)] leading-[1.22] tracking-[-0.01em]">
          <p>«¿Te apetece algo que te acompañe en el bajón, <em>o algo que te saque de él</em>?»</p>
        </blockquote>
        <figcaption class="eyebrow mt-10">Umber, a las once y media de un martes cualquiera</figcaption>
      </figure>
    </section>

    {/* ── Si te gustó… ───────────────────────────────────────────────────── */}
    {
      index.length > 0 && (
        <section aria-labelledby="del-catalogo" class="mx-auto w-full max-w-[80rem] px-5 pt-28 pb-24 sm:px-8 lg:pt-40 lg:pb-32">
          <div class="reveal flex flex-wrap items-end justify-between gap-x-6 gap-y-5">
            <div>
              <p class="eyebrow eyebrow-rule">Del catálogo</p>
              <h2 id="del-catalogo" class="display-2 mt-6 max-w-3xl">
                {indexIsRelated && still !== null ? (
                  <>
                    Si te gustó {still.title}
                  </>
                ) : (
                  <>
                    Seis para empezar
                  </>
                )}
              </h2>
            </div>
            {indexIsRelated && stillHref !== null ? (
              <a href={`${stillHref}#mas-como-esta`} class="link-quiet text-sm">
                Más como esta <span class="arrow" aria-hidden="true">→</span>
              </a>
            ) : (
              <a href={EXPLORE_PATH} class="link-quiet text-sm">
                Ver el catálogo entero <span class="arrow" aria-hidden="true">→</span>
              </a>
            )}
          </div>

          {/* En el móvil, una fila de carteles que se desliza. */}
          <ul class="rail -mx-5 mt-10 px-5 lg:hidden">
            {index.map((item) => (
              <li class="w-[44%] max-w-[12rem]">
                <a href={`${EXPLORE_PATH}/${item.id}`} class="group block">
                  <img
                    src={posterUrl(item.poster_path, 'w342')}
                    srcset={`${posterUrl(item.poster_path, 'w185')} 185w, ${posterUrl(item.poster_path, 'w342')} 342w`}
                    sizes="44vw"
                    alt=""
                    width="342"
                    height="513"
                    loading="lazy"
                    class="ring-umber-ink/10 aspect-[2/3] w-full rounded-[4px] object-cover ring-1"
                  />
                  <span class="mt-3 block font-serif text-[1rem] leading-snug">{item.title}</span>
                  <span class="text-umber-muted mt-0.5 block text-xs">{credit(item)}</span>
                </a>
              </li>
            ))}
          </ul>

          <div data-index class="mt-14 hidden gap-x-10 lg:grid lg:grid-cols-12">
            <ol class="border-umber-line border-t lg:col-span-7">
              {index.map((item, position) => (
                <li class="reveal">
                  <a
                    href={`${EXPLORE_PATH}/${item.id}`}
                    data-index-item={position}
                    class="group border-umber-line grid grid-cols-[3rem_1fr_auto] items-center gap-x-5 border-b py-6"
                  >
                    <span class="font-label text-umber-muted group-hover:text-umber-accent text-xs font-bold tabular-nums transition-colors" aria-hidden="true">
                      {String(position + 1).padStart(2, '0')}
                    </span>
                    <span class="font-display group-hover:text-umber-accent block min-w-0 text-[clamp(1.45rem,2.2vw,2rem)] leading-[1.1] font-semibold tracking-[-0.03em] transition-[color,transform] duration-500 ease-(--ease-soft) group-hover:translate-x-2 motion-reduce:group-hover:translate-x-0">
                      {item.title}
                    </span>
                    <span class="text-umber-muted text-right text-sm">{credit(item)}</span>
                  </a>
                </li>
              ))}
            </ol>

            <div class="lg:col-span-4 lg:col-start-9" aria-hidden="true">
              <div class="sticky top-[calc(var(--header-h)+2.5rem)]">
                <div class="relative isolate aspect-[2/3]">
                  {index.map((item, position) => (
                    <div
                      data-index-poster={position}
                      data-active={position === 0 ? '' : undefined}
                      class="absolute inset-0 isolate scale-[1.02] opacity-0 transition-[opacity,transform] duration-700 ease-(--ease-soft) data-[active]:scale-100 data-[active]:opacity-100"
                    >
                      {/* La luz del cartel en la sala: la misma imagen, pequeña y desenfocada. */}
                      <img src={posterUrl(item.poster_path, 'w92')} alt="" width="92" height="138" loading="lazy" class="ambient size-full object-cover" />
                      <img
                        src={posterUrl(item.poster_path, 'w342')}
                        srcset={`${posterUrl(item.poster_path, 'w342')} 342w, ${posterUrl(item.poster_path, 'w500')} 500w`}
                        sizes="30vw"
                        alt=""
                        width="342"
                        height="513"
                        loading="lazy"
                        class="ring-umber-ink/10 size-full rounded-[4px] object-cover shadow-[0_40px_80px_-30px_rgb(0_0_0/0.85)] ring-1"
                      />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {/* ── La especialidad de otoño ───────────────────────────────────────── */}
    <section aria-labelledby="otono" class="screen bg-umber-base relative isolate overflow-hidden">
      {
        autumnStill !== null && autumnStill.backdrop_path !== null && (
          <div class="absolute inset-0 -z-10" aria-hidden="true">
            <img
              src={backdropUrl(autumnStill.backdrop_path, 'w1280')}
              srcset={`${backdropUrl(autumnStill.backdrop_path, 'w780')} 780w, ${backdropUrl(autumnStill.backdrop_path, 'w1280')} 1280w`}
              sizes="100vw"
              alt=""
              loading="lazy"
              class="size-full object-cover opacity-60 [filter:sepia(0.45)_saturate(1.1)_contrast(1.05)_brightness(0.6)]"
            />
            <div class="from-umber-base via-umber-base/80 absolute inset-0 bg-gradient-to-r to-transparent" />
            <div class="from-umber-base absolute inset-x-0 top-0 h-32 bg-gradient-to-b to-transparent" />
            <div class="from-umber-base absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t to-transparent" />
          </div>
        )
      }
      <div class="mx-auto grid max-w-[80rem] gap-16 px-5 py-28 sm:px-8 lg:grid-cols-12 lg:items-center lg:gap-x-10 lg:py-40">
        <div class="reveal lg:col-span-6">
          <p class="eyebrow eyebrow-rule">
            Especialidad
            <span class="border-umber-rule text-umber-ink ml-2 border px-1.5 py-px text-[0.75rem] font-medium">
              Nuevo
            </span>
          </p>
          <h2 id="otono" class="display-2 mt-6">El Umber de otoño</h2>
          <p class="lead text-umber-ink/80 mt-6 max-w-md">
            Un Umber que solo recomienda cine y series para ver en otoño: luz baja, lluvia, vuelta a las clases,
            cosechas. Sin sustos, salvo que se los pidas.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href="/chat?mode=movie&especialidad=otono" class="btn-primary">
              Una película de otoño <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a href="/chat?mode=tv&especialidad=otono" class="link-quiet text-sm">Una serie de otoño</a>
            <a href={`${EXPLORE_PATH}?sort=autumn`} class="link-quiet text-sm">Lo más otoñal del catálogo</a>
          </div>
        </div>

        {
          autumn.length === 3 && (
            <div class="reveal relative h-[300px] sm:h-[400px] lg:col-span-5 lg:col-start-8 lg:h-[480px]" aria-hidden="true">
              {autumn.map((item, position) => (
                <img
                  src={posterUrl(item.poster_path, 'w342')}
                  srcset={`${posterUrl(item.poster_path, 'w185')} 185w, ${posterUrl(item.poster_path, 'w342')} 342w`}
                  sizes="(min-width: 1024px) 14rem, 38vw"
                  alt=""
                  width="342"
                  height="513"
                  loading="lazy"
                  class={`graded ring-umber-base absolute aspect-[2/3] rounded-[4px] object-cover shadow-[0_40px_70px_-25px_rgb(0_0_0/0.9)] ring-[3px] ${AUTUMN_POSITIONS[position]}`}
                />
              ))}
            </div>
          )
        }
      </div>
    </section>

    {/* ── Los juegos del día ─────────────────────────────────────────────── */}
    <section aria-labelledby="juegos" class="mx-auto w-full max-w-[80rem] px-5 pt-28 pb-16 sm:px-8 lg:pt-36">
      <div class="reveal grid gap-x-10 gap-y-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow eyebrow-rule">
            Juegos
            <span class="border-umber-rule text-umber-ink ml-2 border px-1.5 py-px text-[0.75rem] font-medium">
              Nuevo
            </span>
          </p>
          <h2 id="juegos" class="display-2 mt-6">Una película cada día</h2>
        </div>
        <p class="lead max-w-md lg:col-span-4 lg:col-start-9 lg:pb-2">
          Adivínala por su cartel, cada vez menos desenfocado, o por su título: cuatro letras y unas pistas. Cambian a
          medianoche, y no hace falta cuenta.
        </p>
      </div>

      <ul class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:mt-16">
        <li class="reveal">
          <a
            href="/juegos/cartel"
            class="group border-umber-line bg-umber-surface hover:border-umber-rule grid h-full grid-cols-[6.5rem_1fr] items-end gap-6 border p-5 transition-colors duration-500 sm:grid-cols-[9rem_1fr] sm:gap-8 sm:p-8"
          >
            <div class="poster-frame w-full">
              {games.posterTeaser !== null && <img src={games.posterTeaser} alt="" width="500" height="750" loading="lazy" />}
            </div>
            <div>
              {games.posterNumber !== null && <p class="eyebrow">N.º {games.posterNumber}</p>}
              <h3 class="display-3 group-hover:text-umber-accent mt-3 transition-colors">El cartel del día</h3>
              <p class="text-umber-muted mt-3 text-sm leading-relaxed">Muy desenfocado: con cada intento se ve un poco más. Seis para acertar.</p>
              <span class="font-label text-umber-accent mt-5 inline-flex items-center gap-2 text-[0.9375rem] font-semibold">
                Jugar <span class="arrow" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </li>
        <li class="reveal">
          <a
            href="/juegos/titulo"
            class="group border-umber-line bg-umber-surface hover:border-umber-rule flex h-full flex-col justify-end gap-8 border p-5 transition-colors duration-500 sm:p-8"
          >
            <div class="title-board [--tile:2.4rem] sm:[--tile:2.85rem]" aria-hidden="true">
              <div class="title-row !justify-start">
                <span class="title-word">
                  {SAMPLE.map((letter) => <span class="tile" data-state={letter === '' ? undefined : 'revealed'}>{letter}</span>)}
                </span>
              </div>
            </div>
            <div>
              {games.titleNumber !== null && <p class="eyebrow">N.º {games.titleNumber}</p>}
              <h3 class="display-3 group-hover:text-umber-accent mt-3 transition-colors">El título del día</h3>
              <p class="text-umber-muted mt-3 max-w-sm text-sm leading-relaxed">Elige cuatro letras y mira dónde salen. Si no lo sacas, te ayudan unas pistas.</p>
              <span class="font-label text-umber-accent mt-5 inline-flex items-center gap-2 text-[0.9375rem] font-semibold">
                Jugar <span class="arrow" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </li>
      </ul>
    </section>

    {
      upcoming.length > 0 && (
        <p class="text-umber-muted mx-auto w-full max-w-[80rem] px-5 pt-6 text-sm leading-relaxed sm:px-8">
          <span class="text-umber-ink">En preparación.</span>{' '}
          {upcoming
            .map((mode) => `${mode.label}: ${mode.description.charAt(0).toLowerCase()}${mode.description.slice(1)}`)
            .join(' · ')}
        </p>
      )
    }
  </main>
</Layout>

<script>
  import '@/scripts/home';
</script>
