---
/** Conversaciones guardadas del usuario, para retomarlas o borrarlas. */
import Layout from '@/layouts/Layout.astro';
import { UUID_PATTERN } from '@/lib/api';
import { CONVERSATION_LIST_LIMIT, deleteConversation, listConversations } from '@/lib/conversations';
import { CHAT_MODE_DEFINITIONS } from '@/lib/types';

const { user, supabase } = Astro.locals;
if (user === null) return Astro.redirect('/entrar?next=%2Fconversaciones');

// Borrar es un formulario, para que funcione sin JavaScript.
if (Astro.request.method === 'POST') {
  const id = (await Astro.request.formData()).get('id');
  if (typeof id === 'string' && UUID_PATTERN.test(id)) await deleteConversation(supabase, id);
  return Astro.redirect('/conversaciones', 303);
}

const conversations = await listConversations(supabase);

// La región por defecto de la app es España; hasta la i18n de la Fase 6, la hora va en la suya.
const dateFormat = new Intl.DateTimeFormat('es-ES', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'Europe/Madrid',
});

const PREVIEW_CHARS = 140;
function preview(text: string | null): string {
  if (text === null) return 'Conversación sin mensajes';
  const flat = text.replace(/\s+/gu, ' ').trim();
  return flat.length > PREVIEW_CHARS ? `${flat.slice(0, PREVIEW_CHARS)}…` : flat;
}
---

<Layout title="Conversaciones — Umber">
  <main class="mx-auto w-full max-w-[80rem] flex-1 px-5 sm:px-8">
    <header class="grid gap-x-10 gap-y-6 pt-10 pb-12 sm:pt-14 lg:grid-cols-12 lg:items-end">
      <div class="rise lg:col-span-7">
        <p class="eyebrow eyebrow-rule">Tu historial</p>
        <h1 class="display-1 mt-7">Conversaciones</h1>
      </div>
      {
        conversations.length > 0 && (
          <p class="lead rise max-w-md [animation-delay:120ms] lg:col-span-4 lg:col-start-9 lg:pb-3">
            Retoma cualquiera donde la dejaste: Umber recuerda lo que hablasteis y lo que ya te recomendó.
          </p>
        )
      }
    </header>
    {
      conversations.length === 0 ? (
        <div class="border-umber-line rise border-t py-20 [animation-delay:150ms] lg:grid lg:grid-cols-12 lg:gap-x-10">
          <p class="display-2 lg:col-span-6">
            Aún no tienes <em>conversaciones</em>
          </p>
          <div class="mt-6 lg:col-span-5 lg:col-start-8 lg:mt-3">
            <p class="lead">Las que tengas con Umber se guardan aquí para retomarlas cuando quieras.</p>
            <a href="/" class="btn-primary mt-8">
              Empezar una <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ) : (
        <>
          <ul class="border-umber-line border-t">
            {conversations.map((conversation) => (
              <li class="reveal border-umber-line group relative grid grid-cols-[1fr_auto] items-start gap-x-6 gap-y-2 border-b py-7 sm:grid-cols-[11rem_1fr_auto] lg:grid-cols-[14rem_1fr_auto]">
                <p class="text-umber-ash col-span-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs sm:col-span-1 sm:block sm:pt-1.5">
                  <time datetime={conversation.updatedAt} class="block">
                    {dateFormat.format(new Date(conversation.updatedAt))}
                  </time>
                  <span class="text-umber-cream/80 eyebrow sm:mt-2 sm:block">
                    {CHAT_MODE_DEFINITIONS[conversation.mode].label}
                  </span>
                </p>
                <a
                  href={`/chat?conversation=${conversation.id}`}
                  class="font-serif text-[1.15rem] leading-relaxed transition-colors duration-300 group-hover:text-umber-amber after:absolute after:inset-0 sm:text-[1.25rem]"
                >
                  «{preview(conversation.firstMessage)}»
                </a>
                <form method="post" data-delete-conversation class="relative z-10">
                  <input type="hidden" name="id" value={conversation.id} />
                  <button
                    type="submit"
                    aria-label={`Borrar la conversación «${preview(conversation.firstMessage)}»`}
                    class="link-quiet -mr-2 rounded-full px-3 py-1.5 text-sm hover:bg-umber-cream/[0.05]"
                  >
                    Borrar
                  </button>
                </form>
              </li>
            ))}
          </ul>
          {conversations.length === CONVERSATION_LIST_LIMIT && (
            <p class="text-umber-ash mt-6 text-xs">Se muestran las {CONVERSATION_LIST_LIMIT} más recientes.</p>
          )}
        </>
      )
    }
  </main>
</Layout>

<script>
  import '@/scripts/conversations';
</script>
