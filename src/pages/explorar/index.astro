---
/**
 * Explorar el corpus: rejilla de carteles con búsqueda, tipo, género y orden.
 * Todo va en la URL (`?q=&type=&genre=&sort=&page=`), así que funciona sin
 * JavaScript y cada vista se puede compartir. La lógica está en `src/lib/explore.ts`.
 */
import PosterCard from '@/components/PosterCard.astro';
import Layout from '@/layouts/Layout.astro';
import {
  EXPLORE_PAGE_SIZE,
  EXPLORE_PATH,
  EXPLORE_SORTS,
  exploreHref,
  exploreSearch,
  hasActiveFilters,
  listExplore,
  listGenres,
  parseExploreFilters,
  type ExploreFilters,
} from '@/lib/explore';
import type { ContentType } from '@/lib/types';

const requested = parseExploreFilters(Astro.url.searchParams);
const genres = await listGenres(requested.type);
// Un género que no hay en este tipo (venía de otro filtro) se ignora en vez de dejar la rejilla vacía.
const filters: ExploreFilters = genres.some((item) => item.genre === requested.genre)
  ? requested
  : { ...requested, genre: null };
const { items, total } = await listExplore(filters);
// Pasada la última página no llega ni el total: un enlace viejo vuelve a la primera.
if (items.length === 0 && filters.page > 1) return Astro.redirect(exploreHref(filters));

const pages = Math.max(1, Math.ceil(total / EXPLORE_PAGE_SIZE));
/** Las dos primeras filas en escritorio: se ven nada más abrir, no tiene sentido diferirlas. */
const EAGER_POSTERS = 12;
const numberFormat = new Intl.NumberFormat('es-ES');
const typeTabs: readonly { readonly type: ContentType | null; readonly label: string }[] = [
  { type: null, label: 'Todo' },
  { type: 'movie', label: 'Películas' },
  { type: 'tv', label: 'Series' },
];
// La ficha lleva los filtros en su URL para que «volver» los conserve.
const detailSearch = exploreSearch(filters);

const chevron = 'M6 9l6 6 6-6';
---

<Layout title="Explorar — Umber">
  <main class="mx-auto w-full max-w-[80rem] flex-1 px-5 sm:px-8">
    <header class="grid gap-x-10 gap-y-6 pt-10 pb-12 sm:pt-14 lg:grid-cols-12 lg:items-end lg:pb-16">
      <div class="rise lg:col-span-7">
        <p class="eyebrow eyebrow-rule">El catálogo</p>
        <h1 class="display-1 mt-7">Explorar</h1>
      </div>
      <p class="lead rise max-w-md [animation-delay:120ms] lg:col-span-4 lg:col-start-9 lg:pb-3">
        Las películas y series que conoce Umber, de las más conocidas a las que menos. Si no sabes qué
        buscar, <a href="/" class="link">pregúntale a él</a>.
      </p>
    </header>

    <div
      class="border-umber-line rise flex flex-col gap-x-10 gap-y-6 border-y py-5 [animation-delay:200ms] lg:flex-row lg:items-end lg:justify-between"
    >
      <nav aria-label="Tipo" class="lg:pb-2">
        <ul class="tabs">
          {
            typeTabs.map((tab) => (
              <li>
                <a
                  href={exploreHref(filters, { type: tab.type })}
                  aria-current={filters.type === tab.type ? 'page' : undefined}
                  class="tab"
                >
                  {tab.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <form
        method="get"
        action={EXPLORE_PATH}
        data-explore-filters
        class="grid grid-cols-2 items-end gap-x-6 gap-y-5 sm:grid-cols-[minmax(0,1fr)_11rem_10rem_auto] lg:w-[46rem]"
      >
        {filters.type !== null && <input type="hidden" name="type" value={filters.type} />}
        <div class="col-span-2 sm:col-span-1">
          <label for="q" class="field-label">Buscar</label>
          <input
            id="q"
            name="q"
            type="search"
            value={filters.query}
            maxlength={100}
            placeholder="Título o director"
            class="field text-[0.95rem]"
          />
        </div>
        <div class="min-w-0">
          <label for="genre" class="field-label">Género</label>
          <div class="select-wrap">
            <select id="genre" name="genre" class="field text-[0.95rem]">
              <option value="">Todos</option>
              {
                genres.map((item) => (
                  <option value={item.genre} selected={item.genre === filters.genre}>
                    {item.genre}
                  </option>
                ))
              }
            </select>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={chevron} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
        <div class="min-w-0">
          <label for="sort" class="field-label">Orden</label>
          <div class="select-wrap">
            <select id="sort" name="sort" class="field text-[0.95rem]">
              {
                Object.entries(EXPLORE_SORTS).map(([value, label]) => (
                  <option value={value} selected={value === filters.sort}>
                    {label}
                  </option>
                ))
              }
            </select>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={chevron} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
        <button type="submit" class="btn-secondary col-span-2 px-5 py-2.5 sm:col-span-1">Buscar</button>
      </form>
    </div>

    <div class="mt-8 flex items-baseline justify-between gap-4">
      <p class="text-umber-ash text-sm">
        <span class="text-umber-cream">{total === 1 ? '1 título' : `${numberFormat.format(total)} títulos`}</span>
        {pages > 1 && ` · página ${numberFormat.format(filters.page)} de ${numberFormat.format(pages)}`}
      </p>
      {
        hasActiveFilters(filters) && (
          <a href={exploreHref({ ...filters, query: '', type: null, genre: null })} class="link-quiet text-sm">
            Quitar filtros
          </a>
        )
      }
    </div>

    {
      items.length === 0 ? (
        <div class="py-24 text-center">
          <p class="display-3">
            Nada con <em>esos filtros</em>
          </p>
          <p class="text-umber-ash mt-3">Prueba con otra palabra u otro género.</p>
        </div>
      ) : (
        <ul class="mt-8 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 lg:gap-x-6">
          {items.map((item, index) => (
            <li>
              <PosterCard item={item} href={`${EXPLORE_PATH}/${item.id}${detailSearch}`} eager={index < EAGER_POSTERS} />
            </li>
          ))}
        </ul>
      )
    }

    {
      pages > 1 && items.length > 0 && (
        <nav
          aria-label="Páginas"
          class="border-umber-line mt-20 flex items-center justify-between gap-4 border-t pt-6 text-sm"
        >
          {filters.page > 1 ? (
            <a href={exploreHref(filters, { page: filters.page - 1 })} rel="prev" class="link-quiet">
              <span aria-hidden="true">←</span> Anterior
            </a>
          ) : (
            <span class="text-umber-ash/50" aria-hidden="true">
              ← Anterior
            </span>
          )}
          <span class="font-display text-umber-ash text-lg italic">
            Página {numberFormat.format(filters.page)} de {numberFormat.format(pages)}
          </span>
          {filters.page < pages ? (
            <a href={exploreHref(filters, { page: filters.page + 1 })} rel="next" class="link-quiet">
              Siguiente <span class="arrow" aria-hidden="true">→</span>
            </a>
          ) : (
            <span class="text-umber-ash/50" aria-hidden="true">
              Siguiente →
            </span>
          )}
        </nav>
      )
    }
  </main>
</Layout>

<script>
  import '@/scripts/explore';
</script>
