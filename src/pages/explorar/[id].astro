---
/**
 * Ficha de un título del corpus: fondo, cartel, sinopsis, plataformas y
 * favorito. Llega desde `/explorar` con sus filtros en la URL, y «Explorar» vuelve
 * a ellos. Las plataformas se piden en el servidor, como en favoritos.
 */
import PosterCard from '@/components/PosterCard.astro';
import Layout from '@/layouts/Layout.astro';
import {
  EXPLORE_PATH,
  exploreSearch,
  listSimilar,
  loadExploreTitle,
  parseExploreFilters,
} from '@/lib/explore';
import { listFavoriteIds } from '@/lib/favorites';
import { regionFromAcceptLanguage } from '@/lib/locale';
import { lookupPlatforms } from '@/lib/platforms';
import { TMDB_DEFAULT_REGION, backdropUrl, posterUrl } from '@/lib/tmdb';
import { CHAT_MODE_DEFINITIONS } from '@/lib/types';

const item = await loadExploreTitle(Astro.params.id ?? '');
if (item === null) return Astro.redirect(EXPLORE_PATH);

const { user, supabase } = Astro.locals;
const region =
  regionFromAcceptLanguage(Astro.request.headers.get('accept-language')) ?? TMDB_DEFAULT_REGION;
const [{ platforms, saved }, favoriteIds, similar] = await Promise.all([
  lookupPlatforms([item], region),
  user === null ? Promise.resolve([]) : listFavoriteIds(supabase),
  listSimilar(item.id),
]);
// Esperarla aquí: en Vercel, lo que sigue en marcha tras responder puede no terminar.
await saved;
const itemPlatforms = platforms[0] ?? null;
const favorite = favoriteIds.includes(item.id);

// Los filtros de `/explorar` siguen en la URL de las fichas parecidas: «Explorar» vuelve igual a ellos.
const listSearch = exploreSearch(parseExploreFilters(Astro.url.searchParams));
const backHref = `${EXPLORE_PATH}${listSearch}`;
const loginHref = `/entrar?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
const kind = CHAT_MODE_DEFINITIONS[item.type].label;
const poster = posterUrl(item.poster_path, 'w342');
const posterLarge = posterUrl(item.poster_path, 'w500');
/** Para la luz del cartel: pequeño, que se desenfoca entero. */
const posterSmall = posterUrl(item.poster_path, 'w92');
const backdrop = item.backdrop_path;

function formatRuntime(minutes: number): string {
  const hours = Math.floor(minutes / 60);
  const rest = minutes % 60;
  if (hours === 0) return `${String(rest)} min`;
  return rest === 0 ? `${String(hours)} h` : `${String(hours)} h ${String(rest)} min`;
}

const facts = [
  item.year === null ? null : { label: 'Año', value: String(item.year) },
  item.type === 'movie' && item.runtime !== null && item.runtime > 0
    ? { label: 'Duración', value: formatRuntime(item.runtime) }
    : null,
  item.type === 'tv' && item.seasons !== null
    ? { label: 'Temporadas', value: String(item.seasons) }
    : null,
  item.type === 'tv' && item.status === 'ongoing' ? { label: 'Estado', value: 'En emisión' } : null,
  item.type === 'tv' && item.status === 'ended' ? { label: 'Estado', value: 'Terminada' } : null,
  item.director === null ? null : { label: item.type === 'movie' ? 'Dirección' : 'Creación', value: item.director },
].filter((fact) => fact !== null);
const otherTitle = item.title_en !== null && item.title_en !== item.title ? item.title_en : null;
// Umber recibe este mensaje al abrir el chat, como el de la portada.
const askHref = `/chat?mode=${item.type}&q=${encodeURIComponent(`Algo parecido a «${item.title}»`)}`;

// Para buscadores y para la vista previa al compartir: «Dónde ver…» es lo que se busca.
const yearSuffix = item.year === null ? '' : ` (${String(item.year)})`;
const synopsisLead =
  item.synopsis === null ? '' : ` ${item.synopsis.length > 150 ? `${item.synopsis.slice(0, 150).trimEnd()}…` : item.synopsis}`;
const metaDescription = `Dónde ver ${item.title}${yearSuffix} en streaming, y títulos parecidos.${synopsisLead}`;
const shareImage = backdropUrl(backdrop, 'w1280') ?? posterLarge;
---

<Layout title={`${item.title}${yearSuffix} — dónde verla | Umber`} description={metaDescription} image={shareImage} overlay>
  <main class="flex-1">
    <section class="under-header relative isolate">
      {/*
        El fotograma a sangre, como la pantalla, bajo la cabecera transparente.
        Abajo y a la izquierda se funde con la base de la página (papel en matiné),
        donde va el texto.
      */}
      <div class="absolute inset-x-0 top-0 -z-10 h-[56svh] overflow-hidden sm:h-[64svh] lg:h-[min(50rem,88svh)]" aria-hidden="true">
        {
          backdrop !== null && (
            <img
              src={backdropUrl(backdrop, 'w1280')}
              srcset={`${backdropUrl(backdrop, 'w780')} 780w, ${backdropUrl(backdrop, 'w1280')} 1280w`}
              sizes="100vw"
              alt=""
              fetchpriority="high"
              class="graded develop h-full w-full object-cover object-[50%_25%]"
            />
          )
        }
        <div class="vignette absolute inset-0" />
        <div class="from-umber-base via-umber-base/70 absolute inset-x-0 bottom-0 h-3/4 bg-gradient-to-t to-transparent lg:h-1/2" />
        <div class="from-umber-base/85 via-umber-base/30 absolute inset-y-0 left-0 hidden w-2/3 bg-gradient-to-r to-transparent lg:block" />
        {/* La última, encima de las otras: la cabecera y «Explorar» se leen también en matiné. */}
        <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-black/75 to-transparent" />
      </div>

      <div class="mx-auto max-w-[80rem] px-5 pt-[calc(var(--header-h)+1rem)] sm:px-8">
        <a href={backHref} class="screen link-quiet text-umber-ink/80 text-sm">
          <span aria-hidden="true">←</span> Explorar
        </a>

        <div class="mt-[24svh] grid grid-cols-1 gap-x-10 gap-y-8 sm:mt-[30svh] lg:mt-[min(24rem,48svh)] lg:grid-cols-12">
          <div class="lg:col-span-3">
            <div class="relative isolate w-36 sm:w-52 lg:w-full">
              {posterSmall !== null && <img src={posterSmall} alt="" width="92" height="138" class="ambient size-full object-cover" aria-hidden="true" />}
              <div
                data-poster-target
                class="bg-umber-surface ring-umber-ink/15 aspect-[2/3] overflow-hidden rounded-[4px] shadow-[0_40px_80px_-30px_rgb(0_0_0/0.9)] ring-1 [view-transition-name:poster]"
              >
                {
                  poster === null ? (
                    <div class="text-umber-muted flex h-full items-center justify-center font-serif italic">Sin cartel</div>
                  ) : (
                    <img
                      src={poster}
                      srcset={posterLarge === null ? undefined : `${poster} 342w, ${posterLarge} 500w`}
                      sizes="(min-width: 1024px) 22vw, (min-width: 640px) 208px, 144px"
                      alt={`Cartel de ${item.title}`}
                      width="342"
                      height="513"
                      class="h-full w-full object-cover"
                    />
                  )
                }
              </div>
            </div>
          </div>

          <div class="min-w-0 lg:col-span-8 lg:col-start-5 lg:pt-10">
            <p class="eyebrow eyebrow-rule rise">{kind}</p>
            <h1 class="rise font-display mt-5 text-[clamp(2.6rem,6.4vw,6rem)] leading-[0.95] tracking-[-0.045em] [animation-delay:80ms]">
              {item.title}
            </h1>
            {
              otherTitle !== null && (
                <p class="text-umber-muted rise mt-3 text-xl font-medium tracking-[-0.01em] [animation-delay:140ms]">{otherTitle}</p>
              )
            }

            {
              facts.length > 0 && (
                <dl class="border-umber-line rise mt-10 grid grid-cols-2 gap-x-8 gap-y-5 border-y py-6 [animation-delay:200ms] sm:grid-cols-[repeat(auto-fit,minmax(8rem,auto))]">
                  {facts.map((fact) => (
                    <div class="min-w-0">
                      <dt class="field-label">{fact.label}</dt>
                      <dd class="font-display mt-1.5 text-[1.2rem] leading-tight font-medium tracking-[-0.02em]">{fact.value}</dd>
                    </div>
                  ))}
                </dl>
              )
            }

            {item.synopsis !== null && <p class="reading text-umber-ink/90 mt-9 max-w-[38rem]">{item.synopsis}</p>}

            {
              item.genres.length > 0 && (
                <ul class="mt-7 flex flex-wrap gap-2" aria-label="Géneros">
                  {item.genres.map((genre) => (
                    <li>
                      <a
                        href={`${EXPLORE_PATH}${exploreSearch({ type: item.type, genre, query: '', sort: 'popular', page: 1 })}`}
                        class="chip px-3.5 py-1.5 text-[0.82rem]"
                      >
                        {genre}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }

            {
              itemPlatforms !== null && (
                <div class="mt-10">
                  <p class="field-label">Dónde verla</p>
                  {itemPlatforms.length === 0 ? (
                    <p class="text-umber-muted mt-2 text-sm">No está en plataformas de suscripción ahora mismo.</p>
                  ) : (
                    <ul class="ticket-list mt-3">
                      {itemPlatforms.map((name) => (
                        <li>{name}</li>
                      ))}
                    </ul>
                  )}
                </div>
              )
            }

            {/* `data-content-card`: ahí busca el botón de favorito dónde dar su aviso. */}
            <div data-content-card class="mt-10 flex flex-wrap items-center gap-3">
              <a href={askHref} class="btn-primary">
                Pedirle a Umber algo parecido <span class="arrow" aria-hidden="true">→</span>
              </a>
              {
                user === null ? (
                  <a href={loginHref} class="btn-secondary">
                    Entra para guardarla
                  </a>
                ) : (
                  <button
                    type="button"
                    data-favorite-button
                    data-content-id={item.id}
                    aria-pressed={favorite ? 'true' : 'false'}
                    class="group/fav btn-secondary aria-pressed:border-umber-accent aria-pressed:text-umber-accent aria-pressed:hover:bg-transparent"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 fill-transparent transition-colors group-aria-pressed/fav:fill-current">
                      <path d="M6 4h12v17l-6-4-6 4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                    </svg>
                    <span class="group-aria-pressed/fav:hidden">Guardar</span>
                    <span class="hidden group-aria-pressed/fav:inline">Guardada</span>
                  </button>
                )
              }
              <p data-field="favorite-status" role="status" hidden class="text-umber-accent w-full text-xs"></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {
      similar.length > 0 && (
        <section aria-labelledby="mas-como-esta" class="mx-auto mt-28 w-full max-w-[80rem] px-5 sm:px-8 lg:mt-36">
          <div class="reveal flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="eyebrow eyebrow-rule">Si te gusta esta</p>
              <h2 id="mas-como-esta" class="display-2 mt-6 scroll-mt-8">
                Más como esta
              </h2>
            </div>
          </div>
          {/* En el móvil, una fila que se desliza; desde `sm`, rejilla. */}
          <ul class="rail -mx-5 mt-12 px-5 pb-4 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-x-5 sm:gap-y-10 sm:overflow-visible sm:px-0 sm:pb-0 sm:[mask-image:none] md:grid-cols-4 lg:grid-cols-6 lg:gap-x-6">
            {similar.map((title) => (
              <li class="w-[42%] sm:w-auto">
                <PosterCard item={title} href={`${EXPLORE_PATH}/${title.id}${listSearch}`} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Layout>

<script>
  import { initFavoriteButtons } from '@/scripts/content-card';

  initFavoriteButtons();
</script>
