---
/**
 * Chat con Umber.
 *
 *   /chat?mode=movie            conversación nueva
 *   /chat?mode=movie&q=<texto>  conversación nueva que empieza con ese mensaje (la portada)
 *   /chat?conversation=<uuid>   conversación guardada (exige sesión)
 *   …&especialidad=otono        con la especialidad de otoño (Fase 8)
 *
 * El modo va en la URL para que la página se pueda compartir y recargar. La
 * lógica del navegador está en `src/scripts/chat.ts`.
 */
import ChatMessage from '@/components/ChatMessage.astro';
import ContentCard from '@/components/ContentCard.astro';
import LeafMark from '@/components/LeafMark.astro';
import Layout from '@/layouts/Layout.astro';
import { UUID_PATTERN } from '@/lib/api';
import { loadConversation, type StoredConversation } from '@/lib/conversations';
import { NotFoundError } from '@/lib/errors';
import { listFavoriteIds } from '@/lib/favorites';
import { AI_CONSENT_COOKIE, AI_CONSENT_VERSION } from '@/lib/legal';
import { RECOMMENDATIONS_PER_DAY, recommendationsLeft } from '@/lib/rate-limit';
import { regionFromAcceptLanguage } from '@/lib/locale';
import { loadRecommendations } from '@/lib/recommendations';
import { TMDB_DEFAULT_REGION } from '@/lib/tmdb';
import {
  CHAT_MODE_DEFINITIONS,
  DEFAULT_LOCALE,
  MAX_MESSAGE_CHARS,
  isAvailableChatMode,
  remainingTurns,
  type ChatMode,
} from '@/lib/types';

const { user, supabase } = Astro.locals;

// Decisión de producto (2026-10-11): hablar con Umber exige cuenta. Tras registrarse
// (o entrar), vuelve aquí con su `q`, y el chat envía el mensaje que traía.
if (user === null) {
  return Astro.redirect(`/registro?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}

// Sin el consentimiento para tratar los mensajes en China, no se abre el chat.
// shortcut: /api/chat no lo comprueba (los scripts entran con Bearer); exigirlo allí si se abre la API a terceros
if (Astro.cookies.get(AI_CONSENT_COOKIE)?.value !== AI_CONSENT_VERSION) {
  return Astro.redirect(`/antes-de-hablar?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}

const conversationParam = Astro.url.searchParams.get('conversation');

let conversation: StoredConversation | null = null;
if (conversationParam !== null) {
  if (!UUID_PATTERN.test(conversationParam)) return Astro.redirect('/conversaciones');
  try {
    conversation = await loadConversation(supabase, conversationParam);
  } catch (error: unknown) {
    if (error instanceof NotFoundError) return Astro.redirect('/conversaciones');
    throw error;
  }
}

const modeParam = conversation?.mode ?? Astro.url.searchParams.get('mode');
if (!isAvailableChatMode(modeParam)) return Astro.redirect('/');
const mode: ChatMode = modeParam;
// Una conversación guardada sigue con la suya; una nueva, con la que diga la URL.
const specialty = conversation?.specialty ?? (Astro.url.searchParams.get('especialidad') === 'otono' ? 'autumn' : null);
const definition = CHAT_MODE_DEFINITIONS[mode];

const messages = conversation?.messages ?? [];
// Una conversación guardada que ya llegó al tope se abre cerrada, sin cuadro de texto.
const ended = remainingTurns(messages.length) === 0;
// Sin recomendaciones hoy, el chat se abre cerrado hasta mañana. Admin y pruebas no tienen límite.
const daily = user.isAdmin || user.isTester ? null : await recommendationsLeft(user.id);
const outOfRecommendations = daily?.left === 0;
/** A qué hora vuelven, en la de Madrid: el cupo cambia a medianoche UTC. */
const resetsAt =
  daily === null
    ? null
    : new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' }).format(
        new Date(Date.now() + daily.resetsInSeconds * 1000),
      );
/*
 * El mensaje con el que llega desde la portada: el chat lo envía al abrirse.
 * Puede venir dos veces `q`: el del cuadro y, si se pulsó una sugerencia, el de
 * su botón, que va el último. Vale el último con texto: si había algo escrito y
 * se pulsó la sugerencia, lo que se quería mandar era la sugerencia. Lo valida
 * el servidor al recibirlo, como cualquier otro.
 */
const initialMessage =
  conversation === null && !outOfRecommendations
    ? (Astro.url.searchParams
        .getAll('q')
        .map((value) => value.trim())
        .findLast((value) => value.length > 0) ?? '').slice(0, MAX_MESSAGE_CHARS)
    : '';
const region =
  regionFromAcceptLanguage(Astro.request.headers.get('accept-language')) ?? TMDB_DEFAULT_REGION;
// Las fichas de la conversación guardada: una consulta para todos sus mensajes.
const [favoriteIds, recommendationFor] = await Promise.all([
  user === null ? Promise.resolve([]) : listFavoriteIds(supabase),
  loadRecommendations(
    messages.flatMap((message) => message.recommendation_ids ?? []),
    region,
  ),
]);
const cardsOf = (message: (typeof messages)[number]) =>
  (message.recommendation_ids ?? []).flatMap((id) => {
    const item = recommendationFor(id, message.language ?? DEFAULT_LOCALE);
    return item === null ? [] : [item];
  });

const SUGGESTIONS: Readonly<Record<'movie' | 'tv', readonly string[]>> = {
  movie: [
    'Una comedia para ver en pareja',
    'Algo que me deje pensando un rato',
    'Un thriller que no me deje respirar',
    'Una para ver con niños',
  ],
  tv: [
    'Una serie que enganche desde el principio',
    'Algo ligero para ver a trozos',
    'Una miniserie para el fin de semana',
    'Un drama con buenos personajes',
  ],
};
const countText = (left: number): string =>
  left === 1 ? 'Te queda 1 recomendación hoy' : `Te quedan ${String(left)} recomendaciones hoy`;
const suggestions = mode === 'movie' || mode === 'tv' ? SUGGESTIONS[mode] : [];
---

<Layout title={`${definition.label} — Umber`} footer={false} stickyHeader={false}>
  <main
    data-chat
    data-mode={mode}
    data-specialty={specialty ?? ''}
    data-conversation-id={conversation?.id ?? ''}
    data-message-count={messages.length}
    data-initial-message={initialMessage}
    data-favorites={JSON.stringify(favoriteIds)}
    data-recommendations-left={daily?.left ?? ''}
    class="mx-auto flex w-full max-w-[46rem] flex-1 flex-col px-5 sm:px-8"
  >
    <header class="border-umber-line flex flex-wrap items-end justify-between gap-x-6 gap-y-4 border-b pt-8 pb-7 sm:pt-12">
      <div>
        <p class="eyebrow eyebrow-rule">{specialty === 'autumn' ? `${definition.label} · Otoño` : definition.label}</p>
        <h1 class="display-3 mt-4">
          {mode === 'tv' ? <>Una serie para estos días</> : <>Una película para hoy</>}
        </h1>
      </div>
      <a href="/" class="link-quiet text-sm">Nueva conversación <span class="arrow" aria-hidden="true">→</span></a>
    </header>

    <section aria-label="Conversación" class="flex-1 pt-2 pb-8">
      <div data-empty-state hidden={messages.length > 0 || initialMessage !== ''} class="rise pt-6 pb-6 sm:pt-10 sm:pb-10">
        <p class="eyebrow flex items-center gap-2.5">
          <LeafMark class="text-umber-accent size-3.5" />
          Umber
        </p>
        <p class="display-2 mt-5">¿Cómo te sientes?</p>
        <p class="reading text-umber-muted mt-4 hidden max-w-[34rem] sm:block">
          Cuéntamelo con tus palabras —el tiempo que hace, tu ánimo, con quién la vas a ver— y te busco algo
          que encaje.
        </p>
        <div class="mt-6 sm:mt-10">
          <p id="sugerencias" class="eyebrow">O empieza por aquí</p>
          <ul
            class="rail -mx-5 mt-4 gap-2 px-5 pb-1 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:[mask-image:none]"
            aria-labelledby="sugerencias"
          >
            {
              suggestions.map((suggestion) => (
                <li>
                  <button type="button" data-suggestion class="chip whitespace-nowrap">
                    {suggestion}
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <ol data-messages aria-live="polite" aria-busy="false" class="divide-umber-line divide-y">
        {
          messages.map((message) => (
            <ChatMessage
              role={message.role === 'user' ? 'user' : 'assistant'}
              text={message.content}
              recommendations={cardsOf(message)}
              favoriteIds={favoriteIds}
            />
          ))
        }
      </ol>
    </section>

    <form
      data-composer
      hidden={ended || outOfRecommendations}
      class="from-umber-base via-umber-base/95 sticky bottom-0 -mx-5 bg-gradient-to-t to-transparent px-5 pt-8 pb-[max(1rem,env(safe-area-inset-bottom))] sm:-mx-8 sm:px-8 sm:pb-[max(1.25rem,env(safe-area-inset-bottom))]"
    >
      <p data-turns-left hidden role="status" class="text-umber-accent pb-3 text-center text-xs font-medium"></p>
      <label for="mensaje" class="sr-only">Cuéntale a Umber cómo te sientes</label>
      <div class="composer flex items-end gap-2 p-2.5 pl-4 sm:pl-5">
        <textarea
          id="mensaje"
          name="message"
          rows="2"
          maxlength={MAX_MESSAGE_CHARS}
          required
          placeholder="Escribe aquí cómo estás…"
          class="placeholder:text-umber-muted max-h-48 min-h-12 flex-1 resize-none bg-transparent py-2 font-serif text-[1.08rem] leading-relaxed focus:outline-none"
        ></textarea>
        <button type="button" data-stop hidden class="btn-secondary px-4 py-2.5">Detener</button>
        <button type="submit" data-send class="btn-primary px-5 py-2.5">Enviar</button>
      </div>
      <div class="mt-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-xs">
        {/* Para quien tiene prisa: Umber lo reconoce y recomienda sin más preguntas (`wantsToSkipQuestions`). */}
        <button
          type="button"
          data-skip-questions
          hidden={messages.some((message) => (message.recommendation_ids ?? []).length > 0)}
          class="text-umber-ink hover:text-umber-accent decoration-umber-rule min-h-8 font-medium underline underline-offset-4 transition-colors disabled:opacity-50"
        >
          Recomiéndame ya, sin preguntas
        </button>
        <p data-recommendations-count role="status" class="text-umber-muted ml-auto" hidden={daily === null}>
          {daily !== null && countText(daily.left)}
        </p>
      </div>
      <p class="text-umber-muted mt-1 text-center text-[0.7rem] tracking-[0.02em]">
        <!-- AI Act, art. 50: decir que se habla con una IA -->
        Umber es una IA y puede equivocarse<span class="hidden sm:inline"
          >{' · '}Intro para enviar · Mayúsculas + Intro para un salto de línea</span
        >
      </p>
    </form>

    <div
      data-conversation-end
      hidden={!ended}
      role="status"
      class="border-umber-line -mx-5 border-t px-5 py-10 sm:-mx-8 sm:px-8"
    >
      <p class="eyebrow eyebrow-rule">Fin de la conversación</p>
      <p class="display-3 mt-4">
        Esta conversación ha llegado a su final
      </p>
      <p class="text-umber-muted mt-3">Tus favoritos siguen guardados.</p>
      <a href="/" class="btn-primary mt-7">
        Empezar una nueva <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div
      data-daily-end
      hidden={!outOfRecommendations}
      role="status"
      class="border-umber-line -mx-5 border-t px-5 py-10 sm:-mx-8 sm:px-8"
    >
      <p class="eyebrow eyebrow-rule">Hasta mañana</p>
      <p class="display-3 mt-4">
        Ya tienes tus {RECOMMENDATIONS_PER_DAY} recomendaciones de hoy
      </p>
      <p class="text-umber-muted mt-3 max-w-md leading-relaxed">
        Cada día puedes pedirle a Umber {RECOMMENDATIONS_PER_DAY}{resetsAt !== null && `; vuelven a las ${resetsAt}`}. Mientras, tus favoritos y tus conversaciones
        siguen aquí, y los juegos del día también.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/favoritos" class="btn-primary">
          Tus favoritos <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/juegos" class="btn-secondary">Los juegos del día</a>
      </div>
    </div>

    <template data-template="user"><ChatMessage role="user" /></template>
    <template data-template="assistant"><ChatMessage role="assistant" /></template>
    <template data-template="card"><ContentCard /></template>
  </main>
</Layout>

<script>
  import '@/scripts/chat';
</script>
