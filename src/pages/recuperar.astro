---
/**
 * Recuperar la contraseña: pide el email y manda el enlace con
 * `resetPasswordForEmail`. Vuelve a `/auth/confirm`, que canjea el código y
 * manda a `/cuenta/contrasena` para fijar la nueva.
 *
 * Responde igual si el email no tiene cuenta, para no revelarlo (igual que el
 * registro).
 */
import AuthScene from '@/components/AuthScene.astro';
import Layout from '@/layouts/Layout.astro';
import { readClientAddress } from '@/lib/api';
import { authErrorMessage, type AuthFormError } from '@/lib/auth';
import { RateLimitError } from '@/lib/errors';
import { enforceRateLimit } from '@/lib/rate-limit';

// `/auth/confirm` vuelve aquí si el enlace del correo no sirve.
let error: AuthFormError | null =
  Astro.url.searchParams.get('error') === 'enlace'
    ? {
        message:
          'Ese enlace ya no sirve: caduca a la hora, solo vale una vez y, a veces, solo en el navegador donde lo pediste. Pide uno nuevo.',
        field: null,
      }
    : null;
let email = '';
let sentTo: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const value = form.get('email');
  email = typeof value === 'string' ? value.trim() : '';

  if (email.length === 0) {
    error = { message: 'Escribe tu email.', field: null };
  } else {
    try {
      // Cada envío es un correo del SMTP: el mismo límite que reenviar la confirmación.
      await enforceRateLimit('registro', { userId: null, clientAddress: readClientAddress(Astro) });
      const redirectTo = `${Astro.url.origin}/auth/confirm?next=${encodeURIComponent('/cuenta/contrasena')}`;
      const { error: authError } = await Astro.locals.supabase.auth.resetPasswordForEmail(email, { redirectTo });
      if (authError === null) {
        sentTo = email;
        error = null;
      } else {
        error = { message: authErrorMessage(authError), field: null };
      }
    } catch (rateLimitError: unknown) {
      if (!(rateLimitError instanceof RateLimitError)) throw rateLimitError;
      error = { message: rateLimitError.message, field: null };
      Astro.response.status = 429;
    }
  }
  if (error !== null && Astro.response.status === 200) Astro.response.status = 400;
}
---

<Layout title="Recuperar contraseña — Umber">
  <AuthScene>
    {
      sentTo === null ? (
        <>
          <p class="eyebrow eyebrow-rule rise">Tu cuenta</p>
          <h1 class="display-1 rise mt-7 [animation-delay:80ms]">
            Recuperar <em>contraseña</em>
          </h1>
          <p class="lead rise mt-5 [animation-delay:160ms]">
            Escribe tu email y te mandamos un enlace para elegir una nueva.
          </p>
          <form method="post" class="rise mt-10 space-y-7 [animation-delay:240ms]">
            {
              error !== null && (
                <p role="alert" class="border-l-2 border-umber-danger/70 py-1 pl-4 text-sm leading-relaxed">
                  {error.message}
                </p>
              )
            }
            <div class="space-y-1.5">
              <label for="email" class="field-label">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                value={email}
                autofocus
                class="field text-[1.05rem]"
              />
            </div>
            <div class="pt-3">
              <button type="submit" class="btn-primary w-full py-3.5 text-[0.95rem]">
                Enviar enlace <span class="arrow" aria-hidden="true">→</span>
              </button>
            </div>
          </form>
          <p class="border-umber-line text-umber-muted mt-12 border-t pt-6 text-sm">
            <a href="/entrar" class="link">Volver a entrar</a>
          </p>
        </>
      ) : (
        <div role="status" class="rise">
          <p class="eyebrow eyebrow-rule">Revisa tu correo</p>
          <p class="display-1 mt-7">
            Enlace <em>enviado</em>
          </p>
          <p class="lead mt-6">
            Si <strong class="text-umber-ink font-medium">{sentTo}</strong> tiene cuenta, te hemos enviado un
            enlace para elegir una contraseña nueva. Caduca en una hora.
          </p>
          <ul class="text-umber-muted mt-6 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
            <li>Ábrelo en este mismo navegador: en otro puede no funcionar.</li>
            <li>Si no llega en unos minutos, mira en la carpeta de spam.</li>
          </ul>
          <p class="border-umber-line text-umber-muted mt-10 border-t pt-6 text-sm">
            ¿No ha llegado? <a href="/recuperar" class="link">Pedir otro enlace</a>
          </p>
        </div>
      )
    }
  </AuthScene>
</Layout>
