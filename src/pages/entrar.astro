---
/** Inicio de sesión con email y contraseña. La sesión queda en cookies. */
import AuthForm from '@/components/AuthForm.astro';
import AuthScene from '@/components/AuthScene.astro';
import Layout from '@/layouts/Layout.astro';
import { authErrorMessage, safeRedirectPath, type AuthFormError } from '@/lib/auth';

const next = safeRedirectPath(Astro.url.searchParams.get('next'));
if (Astro.locals.user !== null) return Astro.redirect(next);

/** Errores que llegan en la URL desde `/auth/confirm`. */
const LINK_ERRORS: Readonly<Record<string, string>> = {
  enlace:
    'El enlace ha caducado o ya se ha usado. Si ya confirmaste la cuenta, entra; si no, regístrate otra vez.',
};

const linkError = LINK_ERRORS[Astro.url.searchParams.get('error') ?? ''];
let error: AuthFormError | null = linkError === undefined ? null : { message: linkError, field: null };
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const emailValue = form.get('email');
  const passwordValue = form.get('password');
  email = typeof emailValue === 'string' ? emailValue.trim() : '';
  const password = typeof passwordValue === 'string' ? passwordValue : '';

  if (email.length === 0 || password.length === 0) {
    error = { message: 'Escribe tu email y tu contraseña.', field: null };
  } else {
    const { error: authError } = await Astro.locals.supabase.auth.signInWithPassword({
      email,
      password,
    });
    if (authError === null) return Astro.redirect(next, 303);
    error = { message: authErrorMessage(authError), field: null };
  }
  Astro.response.status = 400;
}
---

<Layout title="Entrar — Umber">
  <AuthScene>
    <p class="eyebrow eyebrow-rule rise">Tu cuenta</p>
    <h1 class="display-1 rise mt-7 [animation-delay:80ms]">Entrar</h1>
    <p class="lead rise mt-5 [animation-delay:160ms]">
      Con cuenta, Umber guarda tus conversaciones y lo que marques como favorito.
    </p>
    <div class="rise [animation-delay:240ms]">
      <AuthForm kind="login" email={email} error={error} />
    </div>
    <p class="border-umber-line text-umber-ash mt-12 border-t pt-6 text-sm">
      ¿No tienes cuenta?{' '}
      <a href={`/registro?next=${encodeURIComponent(next)}`} class="link">Regístrate gratis</a>
    </p>
  </AuthScene>
</Layout>
