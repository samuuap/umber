---
/**
 * Favoritos del usuario. Las plataformas se piden a TMDB desde el servidor al
 * pintar la página: el navegador nunca habla con TMDB.
 */
import ContentCard from '@/components/ContentCard.astro';
import Layout from '@/layouts/Layout.astro';
import { listFavorites } from '@/lib/favorites';
import { regionFromAcceptLanguage } from '@/lib/locale';
import { lookupPlatforms } from '@/lib/platforms';
import { TMDB_DEFAULT_REGION, posterUrl } from '@/lib/tmdb';
import type { Recommendation } from '@/lib/types';

const { user, supabase } = Astro.locals;
if (user === null) return Astro.redirect('/entrar?next=%2Ffavoritos');

const favorites = await listFavorites(supabase);
const region =
  regionFromAcceptLanguage(Astro.request.headers.get('accept-language')) ?? TMDB_DEFAULT_REGION;
const { platforms, saved } = await lookupPlatforms(favorites, region);
// Esperarla aquí: en Vercel, lo que sigue en marcha tras responder puede no terminar.
await saved;

const items: Recommendation[] = favorites.map((favorite, index) => ({
  id: favorite.id,
  tmdb_id: favorite.tmdb_id,
  type: favorite.type,
  title: favorite.title,
  year: favorite.year,
  director: favorite.director,
  genres: favorite.genres,
  poster_url: posterUrl(favorite.poster_path),
  platforms: platforms[index] ?? null,
}));
---

<Layout title="Favoritos — Umber">
  <main class="mx-auto w-full max-w-[80rem] flex-1 px-5 sm:px-8">
    <header class="grid gap-x-10 gap-y-6 pt-10 pb-12 sm:pt-14 lg:grid-cols-12 lg:items-end">
      <div class="rise lg:col-span-7">
        <p class="eyebrow eyebrow-rule">Tu lista</p>
        <h1 class="display-1 mt-7">Favoritos</h1>
      </div>
      {
        items.length > 0 && (
          <p class="lead rise max-w-md [animation-delay:120ms] lg:col-span-4 lg:col-start-9 lg:pb-3">
            {items.length === 1 ? 'Un título guardado' : `${String(items.length)} títulos guardados`}, con dónde
            verlos hoy. Si quitas uno, sigue aquí hasta que recargues, por si fue sin querer.
          </p>
        )
      }
    </header>
    {
      items.length === 0 ? (
        <div class="border-umber-line rise border-t py-20 [animation-delay:150ms] lg:grid lg:grid-cols-12 lg:gap-x-10">
          <p class="display-2 lg:col-span-6">
            Todavía no has <em>guardado</em> nada
          </p>
          <div class="mt-6 lg:col-span-5 lg:col-start-8 lg:mt-3">
            <p class="lead">
              Pide una recomendación y pulsa «Guardar» en su ficha, o guarda lo que te guste mientras exploras: aparecerá
              aquí, con dónde verlo.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/" class="btn-primary">
                Pedir una recomendación <span class="arrow" aria-hidden="true">→</span>
              </a>
              <a href="/explorar" class="btn-secondary">Explorar</a>
            </div>
          </div>
        </div>
      ) : (
        <ul class="border-umber-line grid gap-4 border-t pt-10 md:grid-cols-2 md:gap-5">
          {items.map((item) => (
            <li class="reveal">
              <ContentCard item={item} favorite />
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
