---
/** La hoja de la marca: en la cabecera y como avatar de Umber en el chat. Decorativa. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class={className}>
  <path
    d="M5 19c0-9 6-14 15-14 0 9-5 15-14 15m-1-1 8-8"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
