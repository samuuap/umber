---
/**
 * Un mensaje del chat. Con `text` se pinta en el servidor (conversación
 * guardada), con las fichas de lo que recomendó; sin él sale vacío, como
 * plantilla para el `<script>` del chat.
 *
 * Como un guion: cada intervención con su nombre encima («Tú», «Umber») y un
 * filete entre una y otra, sin burbujas. Umber, en serif de lectura y su nombre
 * en rojo; lo tuyo, en la misma serif y tu nombre en gris.
 */
import ContentCard from '@/components/ContentCard.astro';
import LeafMark from '@/components/LeafMark.astro';
import { renderReply } from '@/lib/markdown';
import type { Recommendation } from '@/lib/types';

interface Props {
  role: 'user' | 'assistant';
  text?: string;
  recommendations?: readonly Recommendation[];
  /** Ids de los favoritos de quien mira, para pintar «Guardada». */
  favoriteIds?: readonly string[];
}

const { role, text = '', recommendations = [], favoriteIds = [] } = Astro.props;
---

{
  role === 'user' ? (
    <li data-role="user" class="message-in py-8">
      <p class="eyebrow">Tú<span class="sr-only">:</span></p>
      <div data-field="body" class="mt-3 font-serif text-[1.05rem] leading-relaxed whitespace-pre-line">
        {text}
      </div>
    </li>
  ) : (
    <li data-role="assistant" class="message-in py-8">
      <p class="eyebrow text-umber-accent flex items-center gap-2.5">
        <LeafMark class="text-umber-accent size-3.5" />
        Umber<span class="sr-only">:</span>
      </p>
      <div class="mt-3.5 space-y-5">
        <p data-field="status" hidden class="breathe text-umber-muted font-serif text-[1.05rem] italic">
          Pensando…
        </p>
        <div
          data-field="body"
          class="reading [&_strong]:text-umber-accent space-y-4 [&_strong]:font-semibold"
          set:html={renderReply(text)}
        />
        <div data-field="error" hidden role="alert" class="border-l-2 border-umber-danger/70 py-1 pl-4 text-sm leading-relaxed">
          <p data-field="error-message" />
          <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
            <a data-field="error-action" hidden class="link" />
            <button type="button" data-retry class="link">
              Reintentar
            </button>
          </div>
        </div>
        <div data-field="cards" class="grid gap-4">
          {recommendations.map((item) => <ContentCard item={item} favorite={favoriteIds.includes(item.id)} />)}
        </div>
      </div>
    </li>
  )
}
