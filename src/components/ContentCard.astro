---
/**
 * Ficha de un título: cartel, datos, plataformas y botón de favorito.
 *
 * Con `item` se pinta en el servidor. Sin él sale vacía, para usarla dentro de
 * un `<template>` que el chat clona y rellena con `fillContentCard`: el marcado
 * vive en un solo sitio.
 *
 * Dentro de un `<template>`, el `<script>` de abajo sale inerte (Astro lo pinta
 * junto al componente): quien use la plantilla llama él a `initFavoriteButtons()`.
 */
import { returnPath } from '@/lib/auth';
import { describeCard, similarHref } from '@/scripts/content-card';
import type { Recommendation } from '@/lib/types';

interface Props {
  item?: Recommendation;
  favorite?: boolean;
}

const { item, favorite = false } = Astro.props;
const description = item === undefined ? null : describeCard(item);
const posterUrl = item?.poster_url ?? null;
const platforms = item?.platforms ?? null;
const signedIn = Astro.locals.user !== null;
const loginHref = `/entrar?next=${encodeURIComponent(returnPath(Astro.url))}`;
---

<article
  data-content-card
  data-content-id={item?.id}
  class="border-umber-line bg-umber-surface/80 relative isolate grid grid-cols-[6.5rem_1fr] gap-5 overflow-hidden border p-4 sm:grid-cols-[9rem_1fr] sm:gap-7 sm:p-6"
>
  {/* La luz del cartel tiñe la ficha: la misma imagen, ya descargada, muy desenfocada. */}
  <img
    data-field="poster-glow"
    src={posterUrl ?? undefined}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    hidden={posterUrl === null}
    class="pointer-events-none absolute inset-0 -z-10 size-full scale-125 object-cover opacity-20 blur-[64px] saturate-150"
  />
  <div
    class="bg-umber-raised ring-umber-ink/10 relative aspect-[2/3] self-start overflow-hidden rounded-[4px] shadow-[0_24px_48px_-24px_rgb(0_0_0/0.8)] ring-1"
  >
    <img
      data-field="poster"
      src={posterUrl ?? undefined}
      alt={description?.posterAlt ?? ''}
      width="342"
      height="513"
      loading="lazy"
      decoding="async"
      hidden={posterUrl === null}
      class="h-full w-full object-cover"
    />
    <div
      data-field="no-poster"
      hidden={posterUrl !== null}
      class="text-umber-muted flex h-full items-center justify-center p-2 text-center font-serif text-sm italic"
    >
      Sin cartel
    </div>
  </div>

  <div class="flex min-w-0 flex-col">
    <p data-field="kind" class="eyebrow">
      {description?.kind}
    </p>
    <h3 class="mt-2 text-[1.65rem] leading-[1.05] tracking-[-0.02em] sm:text-[2.15rem]">
      <span data-field="title">{description?.title}</span>{' '}
      <span
        data-field="year"
        hidden={description?.year == null}
        class="text-umber-muted font-sans text-sm tracking-normal whitespace-nowrap"
      >
        {description?.year}
      </span>
    </h3>
    <p data-field="credit" hidden={description?.credit == null} class="text-umber-muted mt-2 text-sm">
      {description?.credit}
    </p>
    <p data-field="genres" hidden={description?.genres == null} class="text-umber-muted/85 mt-0.5 text-xs">
      {description?.genres}
    </p>

    <div data-field="platforms-block" hidden={platforms === null} class="border-umber-line mt-4 border-t pt-3.5">
      <p class="field-label">Dónde verla</p>
      {/* El estilo va en el padre: así vale también para los `<li>` que crea el chat. */}
      <ul data-field="platforms" hidden={platforms !== null && platforms.length === 0} class="ticket-list mt-2.5">
        {platforms?.map((name) => <li>{name}</li>)}
      </ul>
      <p data-field="no-platforms" hidden={platforms?.length !== 0} class="text-umber-muted mt-1.5 text-sm">
        No está en plataformas de suscripción ahora mismo.
      </p>
    </div>

    <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-4">
      {
        signedIn ? (
          <button
            type="button"
            data-favorite-button
            data-content-id={item?.id}
            aria-pressed={favorite ? 'true' : 'false'}
            class="group/fav border-umber-rule/70 text-umber-ink hover:border-umber-accent aria-pressed:border-umber-accent aria-pressed:text-umber-accent inline-flex items-center gap-2 border px-3.5 py-1.5 text-sm font-medium transition-colors duration-300"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="size-3.5 fill-transparent transition-colors group-aria-pressed/fav:fill-current">
              <path d="M6 4h12v17l-6-4-6 4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
            </svg>
            <span class="group-aria-pressed/fav:hidden">Guardar</span>
            <span class="hidden group-aria-pressed/fav:inline">Guardada</span>
          </button>
        ) : (
          <a
            href={loginHref}
            target="_blank"
            rel="noopener"
            class="link-quiet text-sm underline decoration-1 underline-offset-4"
          >
            Entra para guardarla<span class="sr-only"> (se abre en otra pestaña)</span>
          </a>
        )
      }
      {/* En otra pestaña: sin sesión, la conversación solo vive en esta. */}
      <a
        data-field="similar-link"
        href={item === undefined ? undefined : similarHref(item.id)}
        target="_blank"
        rel="noopener"
        class="link-quiet text-sm"
      >
        Más como esta <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> (se abre en otra pestaña)</span>
      </a>
      <p data-field="favorite-status" role="status" hidden class="text-umber-accent w-full text-xs"></p>
    </div>
  </div>
</article>

<script>
  import { initFavoriteButtons } from '@/scripts/content-card';

  initFavoriteButtons();
</script>
