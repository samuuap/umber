---
/**
 * Pie común: los créditos finales. Como al terminar una película, en la
 * pantalla (`.screen`, oscura también en el modo claro): el oficio a un lado
 * del eje y el nombre al otro, y el título grande al final.
 *
 * La atribución a TMDB la exigen sus condiciones de uso de la API, y la de
 * JustWatch, las de los datos de plataformas que TMDB redistribuye.
 */
import { EXPLORE_PATH } from '@/lib/explore';
import { LEGAL_PAGES } from '@/lib/legal';

const user = Astro.locals.user;
const year = new Date().getFullYear();

const links = [
  { href: '/', label: 'Pedir una recomendación' },
  { href: EXPLORE_PATH, label: 'Explorar el catálogo' },
  { href: '/juegos', label: 'Los juegos del día' },
  ...(user === null
    ? [
        { href: '/registro', label: 'Crear una cuenta' },
        { href: '/entrar', label: 'Entrar' },
      ]
    : [
        { href: '/conversaciones', label: 'Tus conversaciones' },
        { href: '/favoritos', label: 'Tus favoritos' },
      ]),
  { href: '/sobre-umber', label: '¿Por qué Umber?' },
];

const linkClass = 'text-umber-ink hover:text-umber-accent underline decoration-umber-rule decoration-1 underline-offset-[6px] transition-colors';
---

<footer class="screen bg-umber-base border-umber-line mt-28 border-t pb-[env(safe-area-inset-bottom)]">
  <section aria-labelledby="creditos" class="mx-auto max-w-[80rem] px-5 pt-20 pb-16 sm:px-8 sm:pt-24">
    <h2 id="creditos" class="eyebrow text-center">Créditos</h2>
    <dl class="mx-auto mt-10 grid max-w-2xl gap-y-5">
      <div class="grid grid-cols-2 items-baseline gap-x-5 sm:gap-x-8">
        <dt class="field-label text-right">Recomendaciones</dt>
        <dd class="font-display text-[1.2rem] leading-tight font-medium tracking-[-0.02em] sm:text-[1.5rem]">Umber, una IA</dd>
      </div>
      <div class="grid grid-cols-2 items-baseline gap-x-5 sm:gap-x-8">
        <dt class="field-label text-right">Catálogo</dt>
        <dd class="font-display text-[1.2rem] leading-tight font-medium tracking-[-0.02em] sm:text-[1.5rem]">Unas 16.000 películas y series</dd>
      </div>
      <div class="grid grid-cols-2 items-baseline gap-x-5 sm:gap-x-8">
        <dt class="field-label text-right">Datos e imágenes</dt>
        <dd class="font-display text-[1.2rem] leading-tight font-medium tracking-[-0.02em] sm:text-[1.5rem]">
          <a href="https://www.themoviedb.org/" class={linkClass}>TMDB</a>
        </dd>
      </div>
      <div class="grid grid-cols-2 items-baseline gap-x-5 sm:gap-x-8">
        <dt class="field-label text-right">Plataformas de streaming</dt>
        <dd class="font-display text-[1.2rem] leading-tight font-medium tracking-[-0.02em] sm:text-[1.5rem]">
          <a href="https://www.justwatch.com/" class={linkClass}>JustWatch</a>
        </dd>
      </div>
    </dl>
    <p class="text-umber-muted mx-auto mt-10 max-w-sm text-center text-xs leading-relaxed">
      Umber usa la API de TMDB, pero no está respaldado ni certificado por TMDB.
    </p>
  </section>

  <div class="border-umber-line border-t">
    <div class="mx-auto grid max-w-[80rem] gap-x-10 gap-y-12 px-5 py-14 sm:px-8 md:grid-cols-12 md:items-end lg:py-20">
      <div class="md:col-span-7">
        <p class="font-display text-[clamp(4.5rem,15vw,12rem)] leading-[0.8] font-semibold tracking-[-0.06em]" aria-hidden="true">
          Umber<span class="text-umber-accent">.</span>
        </p>
        <p class="text-umber-muted mt-6 max-w-xs leading-relaxed">
          Tu cinéfilo de confianza: películas y series elegidas <span class="text-umber-ink">con calma</span>.
        </p>
      </div>

      <nav aria-label="Pie" class="md:col-span-4 md:col-start-9">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm md:grid-cols-1">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="link-quiet">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-umber-line border-t">
    <div class="text-umber-muted mx-auto flex max-w-[80rem] flex-wrap justify-between gap-x-6 gap-y-2 px-5 py-6 text-xs sm:px-8">
      <span>Umber, {year}</span>
      <nav aria-label="Legal">
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          {
            LEGAL_PAGES.map((page) => (
              <li>
                <a href={page.href} class="link-quiet">
                  {page.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <span>Hecho con calma y mucho cine</span>
    </div>
  </div>
</footer>
