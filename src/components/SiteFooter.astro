---
/**
 * Pie común. La atribución a TMDB la exigen sus condiciones de uso de la API, y
 * la de JustWatch, las de los datos de plataformas que TMDB redistribuye.
 */
import LeafMark from '@/components/LeafMark.astro';
import { EXPLORE_PATH } from '@/lib/explore';

const user = Astro.locals.user;
const year = new Date().getFullYear();

const links = [
  { href: '/', label: 'Pedir una recomendación' },
  { href: EXPLORE_PATH, label: 'Explorar el catálogo' },
  ...(user === null
    ? [
        { href: '/registro', label: 'Crear una cuenta' },
        { href: '/entrar', label: 'Entrar' },
      ]
    : [
        { href: '/conversaciones', label: 'Tus conversaciones' },
        { href: '/favoritos', label: 'Tus favoritos' },
      ]),
];
---

<footer class="border-umber-line mt-28 border-t">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-16 sm:px-8 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="font-display flex items-center gap-3 text-5xl tracking-[-0.035em]">
        <LeafMark class="text-umber-amber size-7" />
        Umber
      </p>
      <p class="text-umber-ash mt-5 max-w-xs leading-relaxed">
        Tu cinéfilo de confianza: películas y series elegidas <em class="font-display text-umber-cream text-[1.15em]">con calma</em>.
      </p>
    </div>

    <nav aria-label="Pie" class="md:col-span-3 md:col-start-7">
      <p class="eyebrow">Umber</p>
      <ul class="mt-5 space-y-2.5 text-sm">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="link-quiet">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="text-umber-ash space-y-3 text-sm leading-relaxed md:col-span-3">
      <p class="eyebrow">Créditos</p>
      <p class="pt-2">
        Datos e imágenes de{' '}
        <a href="https://www.themoviedb.org/" class="text-umber-cream/90 hover:text-umber-cream underline decoration-1 underline-offset-4"
          >TMDB</a
        >. Umber usa la API de TMDB, pero no está respaldado ni certificado por TMDB.
      </p>
      <p>
        Plataformas de streaming según{' '}
        <a href="https://www.justwatch.com/" class="text-umber-cream/90 hover:text-umber-cream underline decoration-1 underline-offset-4"
          >JustWatch</a
        >.
      </p>
    </div>
  </div>
  <div class="border-umber-line border-t">
    <p
      class="text-umber-ash mx-auto flex max-w-[80rem] flex-wrap justify-between gap-x-6 gap-y-1 px-5 py-6 text-xs sm:px-8"
    >
      <span>Umber, {year}</span>
      <span>Hecho con calma y mucho cine</span>
    </p>
  </div>
</footer>
