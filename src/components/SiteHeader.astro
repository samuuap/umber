---
/**
 * Cabecera común: marca y navegación, según haya sesión o no. En las
 * transiciones entre páginas se queda quieta (`[view-transition-name:header]`).
 * Por debajo de `lg`, los enlaces van en un menú (`<details>`, sin JavaScript);
 * «Entrar» y el modo se quedan a la vista.
 */
import { returnPath } from '@/lib/auth';

const user = Astro.locals.user;
const current = Astro.url.pathname;
const next = encodeURIComponent(returnPath(Astro.url));

const links = [
  // El producto: hablar con Umber. Sin sesión, /chat lleva a crear la cuenta y lo explica.
  { href: '/chat?mode=movie', label: 'Recomiéndame' },
  { href: '/explorar', label: 'Explorar' },
  { href: '/juegos', label: 'Juegos' },
  ...(user === null
    ? []
    : [
        { href: '/conversaciones', label: 'Conversaciones' },
        { href: '/favoritos', label: 'Favoritos' },
        { href: '/cuenta', label: 'Cuenta' },
        ...(user.isAdmin ? [{ href: '/admin', label: 'Admin' }] : []),
      ]),
];
// Una ficha de /explorar/<id> sigue dentro de «Explorar».
const isCurrent = (href: string): boolean => {
  const path = href.split('?')[0] ?? href;
  return current === path || current.startsWith(`${path}/`);
};

// La línea de fecha del programa de mano, solo en la portada. El día de Madrid, como
// `GAME_TIME_ZONE` de los juegos (no se importa: `games.ts` arrastra `sharp` a todas las páginas).
const today = new Intl.DateTimeFormat('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'Europe/Madrid',
}).format(new Date());
---

{
  current === '/' && (
    <div class="border-umber-ink border-b">
      <p class="font-label mx-auto flex font-semibold max-w-[80rem] flex-wrap justify-between gap-x-6 gap-y-1 px-5 py-2.5 text-[0.7rem] tracking-[0.14em] uppercase sm:px-8">
        <span>{today.charAt(0).toUpperCase() + today.slice(1)}</span>
        <span class="text-umber-muted">Programa del día</span>
      </p>
    </div>
  )
}

<header class="border-umber-line relative z-30 border-b [view-transition-name:header]">
  <div
    class="mx-auto flex max-w-[80rem] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 pt-5 pb-4 sm:px-8 sm:pt-6"
  >
    <a href="/" class="font-display text-[2.1rem] leading-none tracking-[-0.01em]" aria-label="Umber, inicio">
      Umber<span class="text-umber-accent" aria-hidden="true">.</span>
    </a>

    <div class="flex items-center gap-x-2.5 text-sm sm:gap-x-6">
      <nav aria-label="Principal" class="hidden items-center gap-x-6 lg:flex">
        <ul class="flex items-center gap-x-6">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="tab whitespace-nowrap" aria-current={isCurrent(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            user?.username != null && (
              <li class="text-umber-muted pb-1.5" title="Tu nombre de usuario">
                @{user.username}
              </li>
            )
          }
        </ul>
        {
          user !== null && (
            <form method="post" action="/salir">
              <button type="submit" class="tab">
                Salir
              </button>
            </form>
          )
        }
      </nav>
      {
        user === null && (
          <a
            href={`/entrar?next=${next}`}
            aria-current={current === '/entrar' ? 'page' : undefined}
            class="btn-secondary px-4 py-2 text-[0.8rem]"
          >
            Entrar
          </a>
        )
      }
      {/* La etiqueta la pone src/scripts/theme.ts según el modo; sin JavaScript no hace nada. */}
      <button
        type="button"
        data-theme-toggle
        aria-label="Cambiar entre modo claro y oscuro"
        class="border-umber-line text-umber-ink hover:border-umber-ink inline-flex size-11 shrink-0 items-center justify-center border transition-colors"
      >
        <svg aria-hidden="true" class="size-[18px] in-data-[current=dark]:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" />
        </svg>
        <svg aria-hidden="true" class="hidden size-[18px] in-data-[current=dark]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <details class="group lg:hidden">
        <summary
          class="border-umber-line text-umber-ink hover:border-umber-ink font-label inline-flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center gap-2 border px-3 text-[0.8rem] font-bold tracking-[0.12em] uppercase transition-colors [&::-webkit-details-marker]:hidden"
        >
          <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16" />
            <path class="hidden group-open:block" d="M6 6l12 12M18 6 6 18" />
          </svg>
          <span class="sr-only sm:not-sr-only">Menú</span>
        </summary>
        <nav
          aria-label="Principal"
          class="border-umber-line bg-umber-base absolute inset-x-0 top-full border-b px-5 pb-6 shadow-[0_24px_40px_-24px_rgb(0_0_0/0.35)] sm:px-8"
        >
          <ul>
            {
              links.map((link) => (
                <li class="border-umber-line border-b">
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                    class="font-display aria-[current=page]:text-umber-accent flex min-h-14 items-center text-[1.6rem] leading-none"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
          {
            user !== null && (
              <div class="mt-5 flex items-center justify-between gap-4">
                {user.username != null && <span class="text-umber-muted">@{user.username}</span>}
                <form method="post" action="/salir" class="ml-auto">
                  <button type="submit" class="btn-secondary px-4 py-2 text-[0.8rem]">
                    Salir
                  </button>
                </form>
              </div>
            )
          }
        </nav>
      </details>
    </div>
  </div>
</header>
