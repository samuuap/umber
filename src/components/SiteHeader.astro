---
/**
 * Cabecera común: marca y navegación, según haya sesión o no. Es parte de la
 * pantalla (`.screen`): oscura también en el modo claro, como las franjas de
 * un cine. Fija arriba al bajar, salvo en el chat (`sticky`), y transparente
 * sobre el fotograma de la portada y de la ficha (`overlay`), hasta que se baja.
 * En las transiciones entre páginas se queda quieta (`[view-transition-name:header]`).
 *
 * Por debajo de `lg`, los enlaces van en un menú a pantalla completa
 * (`<details>`, sin JavaScript); «Entrar» y el modo se quedan a la vista.
 */
import { returnPath } from '@/lib/auth';

interface Props {
  overlay?: boolean;
  sticky?: boolean;
}

const { overlay = false, sticky = true } = Astro.props;
const user = Astro.locals.user;
const current = Astro.url.pathname;
const next = encodeURIComponent(returnPath(Astro.url));

const links = [
  // El producto: hablar con Umber. Sin sesión, /chat lleva a crear la cuenta y lo explica.
  { href: '/chat?mode=movie', label: 'Recomiéndame' },
  { href: '/explorar', label: 'Explorar' },
  { href: '/juegos', label: 'Juegos' },
  ...(user === null
    ? []
    : [
        { href: '/conversaciones', label: 'Conversaciones' },
        { href: '/favoritos', label: 'Favoritos' },
        { href: '/cuenta', label: 'Cuenta' },
        ...(user.isAdmin ? [{ href: '/admin', label: 'Admin' }] : []),
      ]),
];
// Una ficha de /explorar/<id> sigue dentro de «Explorar».
const isCurrent = (href: string): boolean => {
  const path = href.split('?')[0] ?? href;
  return current === path || current.startsWith(`${path}/`);
};
---

<header
  class:list={[
    'screen z-40 border-b [view-transition-name:header]',
    sticky ? 'sticky top-0' : 'relative',
    overlay ? 'header-overlay border-transparent' : 'header-solid border-umber-line',
  ]}
>
  <div class="mx-auto flex h-(--header-h) max-w-[80rem] items-center justify-between gap-x-6 px-5 sm:px-8">
    <a href="/" class="font-display text-[1.6rem] leading-none font-bold tracking-[-0.05em] sm:text-[1.8rem]" aria-label="Umber, inicio">
      Umber<span class="text-umber-accent" aria-hidden="true">.</span>
    </a>

    <div class="flex items-center gap-x-2.5 text-sm sm:gap-x-6">
      <nav aria-label="Principal" class="hidden items-center gap-x-7 lg:flex">
        <ul class="flex items-center gap-x-7">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="tab whitespace-nowrap" aria-current={isCurrent(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            user?.username != null && (
              <li class="text-umber-muted pb-1.5" title="Tu nombre de usuario">
                @{user.username}
              </li>
            )
          }
        </ul>
        {
          user !== null && (
            <form method="post" action="/salir">
              <button type="submit" class="tab">
                Salir
              </button>
            </form>
          )
        }
      </nav>
      {
        user === null && (
          <a
            href={`/entrar?next=${next}`}
            aria-current={current === '/entrar' ? 'page' : undefined}
            class="btn-secondary min-h-10 px-4 py-2 text-sm"
          >
            Entrar
          </a>
        )
      }
      {/* La etiqueta la pone src/scripts/theme.ts según el modo; sin JavaScript no hace nada. */}
      <button
        type="button"
        data-theme-toggle
        aria-label="Cambiar entre modo claro y oscuro"
        class="text-umber-muted hover:text-umber-ink hover:border-umber-rule inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-transparent transition-colors sm:size-11"
      >
        <svg aria-hidden="true" class="size-[18px] in-data-[current=light]:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg aria-hidden="true" class="hidden size-[18px] in-data-[current=light]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" />
        </svg>
      </button>
      <details data-menu class="group lg:hidden">
        <summary
          class="text-umber-ink hover:border-umber-rule inline-flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-transparent transition-colors sm:size-11 [&::-webkit-details-marker]:hidden"
        >
          <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <path class="group-open:hidden" d="M4 8h16M8 16h12" />
            <path class="hidden group-open:block" d="M6 6l12 12M18 6 6 18" />
          </svg>
          <span class="sr-only">Menú</span>
        </summary>
        {/*
          Bajo la cabecera y hasta el final de la pantalla. `absolute` y no `fixed`:
          el desenfoque de la cabecera la convierte en el contenedor de lo fijo.
        */}
        <nav
          aria-label="Principal"
          class="bg-umber-base absolute inset-x-0 top-full flex h-[calc(100dvh-var(--header-h))] flex-col overflow-y-auto px-5 pt-6 pb-[max(2rem,env(safe-area-inset-bottom))] sm:px-8"
        >
          <ul>
            {
              links.map((link, position) => (
                <li class:list={['border-umber-line border-b', position === 0 && 'border-t']}>
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                    class="font-display aria-[current=page]:text-umber-accent flex min-h-[4.25rem] items-center justify-between gap-4 text-[2rem] leading-none font-semibold tracking-[-0.035em]"
                  >
                    {link.label}
                    <span class="text-umber-muted font-sans text-lg" aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
          {
            user !== null && (
              <div class="mt-auto flex items-center justify-between gap-4 pt-8">
                {user.username != null && <span class="text-umber-muted">@{user.username}</span>}
                <form method="post" action="/salir" class="ml-auto">
                  <button type="submit" class="btn-secondary px-4 py-2 text-sm">
                    Salir
                  </button>
                </form>
              </div>
            )
          }
        </nav>
      </details>
    </div>
  </div>
</header>
