---
/**
 * Las plataformas como chips que se marcan, de la que más títulos tiene a la
 * que menos, con «Todas» delante. En el chat, antes de empezar, y en `/cuenta`
 * («Mis plataformas»). Sin JavaScript son casillas normales; con él, «Todas»
 * marca o desmarca el resto (`src/scripts/platform-picker.ts`).
 */
import PlatformChip from '@/components/PlatformChip.astro';
import type { PlatformCount } from '@/lib/platforms';

interface Props {
  platforms: readonly PlatformCount[];
  /** Las que salen marcadas. */
  checked: readonly string[];
  legend: string;
  /** Qué cuenta el número de cada una: «películas», «series» o «títulos». */
  unit: string;
}

const { platforms, checked, legend, unit } = Astro.props;
/** Las que se ven de entrada; el resto, que suelen tener pocos títulos, detrás de «Ver más». */
const VISIBLE = 12;
const marked = new Set(checked);
// Una marcada de las de abajo no puede quedar escondida.
const openMore = platforms.slice(VISIBLE).some((platform) => marked.has(platform.name));
const all = platforms.length > 0 && platforms.every((platform) => marked.has(platform.name));
---

<fieldset data-platform-picker class="chip-check">
  <legend class="sr-only">{legend}</legend>
  <ul class="flex flex-wrap gap-2">
    <li>
      <label>
        <input type="checkbox" data-platform-all class="sr-only" checked={all} />
        <span class="chip font-medium">Todas</span>
      </label>
    </li>
    {
      platforms
        .slice(0, VISIBLE)
        .map((platform) => <PlatformChip platform={platform} checked={marked.has(platform.name)} unit={unit} />)
    }
  </ul>
  {
    platforms.length > VISIBLE && (
      <details open={openMore} class="mt-3">
        <summary class="link-quiet cursor-pointer text-sm">Ver {platforms.length - VISIBLE} más</summary>
        <ul class="mt-3 flex flex-wrap gap-2">
          {platforms.slice(VISIBLE).map((platform) => (
            <PlatformChip platform={platform} checked={marked.has(platform.name)} unit={unit} />
          ))}
        </ul>
      </details>
    )
  }
</fieldset>

<script>
  import '@/scripts/platform-picker';
</script>
