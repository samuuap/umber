---
/**
 * Formulario para entrar o registrarse. Funciona sin JavaScript: envía a la misma
 * página, que lo valida todo en el servidor. Con JavaScript (`src/scripts/auth-form.ts`)
 * añade el botón de mostrar la contraseña y avisa al momento si las dos no coinciden.
 */
import {
  MAX_PASSWORD_CHARS,
  MIN_PASSWORD_CHARS,
  USERNAME_INPUT_PATTERN,
  type AuthFormError,
  type AuthFormField,
} from '@/lib/auth';

interface Props {
  kind: 'login' | 'signup';
  email?: string;
  username?: string;
  error?: AuthFormError | null;
  /** Adonde volver tras entrar, para `/auth/google?next=…`. */
  next: string;
}

const { kind, email = '', username = '', error = null, next } = Astro.props;
const signup = kind === 'signup';

const inputClass = 'field text-[1.05rem]';
const labelClass = 'field-label';
const helpClass = 'text-umber-ash text-xs';
const errorClass = 'text-xs text-red-300';

const errorFor = (field: AuthFormField): string | null => (error?.field === field ? error.message : null);
const describedBy = (field: AuthFormField, help: boolean): string | undefined =>
  [help ? `${field}-help` : null, errorFor(field) === null ? null : `${field}-error`]
    .filter((id) => id !== null)
    .join(' ') || undefined;

const passwordFields = signup
  ? [
      {
        name: 'password',
        label: 'Contraseña',
        autocomplete: 'new-password',
        help: `De ${String(MIN_PASSWORD_CHARS)} a ${String(MAX_PASSWORD_CHARS)} caracteres.`,
      },
      { name: 'password_confirm', label: 'Repite la contraseña', autocomplete: 'new-password', help: null },
    ] as const
  : ([{ name: 'password', label: 'Contraseña', autocomplete: 'current-password', help: null }] as const);
---

{
  error !== null && error.field === null && (
    <p role="alert" class="mt-8 border-l-2 border-red-400/70 py-1 pl-4 text-sm leading-relaxed">
      {error.message}
    </p>
  )
}

<form method="post" data-auth-form class="mt-10 space-y-7">
  {
    signup && (
      <div class="space-y-1.5">
        <label for="username" class={labelClass}>
          Nombre de usuario
        </label>
        <input
          id="username"
          name="username"
          type="text"
          autocomplete="nickname"
          autocapitalize="none"
          spellcheck="false"
          required
          minlength={3}
          maxlength={20}
          pattern={USERNAME_INPUT_PATTERN}
          title="De 3 a 20 caracteres: letras sin tilde, números o guion bajo."
          value={username}
          aria-invalid={errorFor('username') === null ? undefined : 'true'}
          aria-describedby={describedBy('username', true)}
          autofocus={errorFor('username') !== null}
          class={inputClass}
        />
        <p id="username-help" class={helpClass}>
          De 3 a 20 caracteres: letras sin tilde, números o guion bajo.
        </p>
        {errorFor('username') !== null && (
          <p id="username-error" role="alert" class={errorClass}>
            {errorFor('username')}
          </p>
        )}
      </div>
    )
  }

  <div class="space-y-1.5">
    <label for="email" class={labelClass}>Email</label>
    <input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      required
      value={email}
      aria-invalid={errorFor('email') === null ? undefined : 'true'}
      aria-describedby={describedBy('email', false)}
      autofocus={errorFor('email') !== null}
      class={inputClass}
    />
    {
      errorFor('email') !== null && (
        <p id="email-error" role="alert" class={errorClass}>
          {errorFor('email')}
        </p>
      )
    }
  </div>

  {
    passwordFields.map((field) => (
      <div class="space-y-1.5">
        <label for={field.name} class={labelClass}>
          {field.label}
        </label>
        <div class="relative">
          <input
            id={field.name}
            name={field.name}
            type="password"
            autocomplete={field.autocomplete}
            required
            minlength={signup ? MIN_PASSWORD_CHARS : undefined}
            maxlength={signup ? MAX_PASSWORD_CHARS : undefined}
            aria-invalid={errorFor(field.name) === null ? undefined : 'true'}
            aria-describedby={describedBy(field.name, field.help !== null)}
            autofocus={errorFor(field.name) !== null}
            class={`${inputClass} pr-20`}
          />
          {/* Sin JavaScript no hace nada: el script le quita el `hidden`. */}
          <button
            type="button"
            data-password-toggle
            aria-controls={field.name}
            hidden
            class="text-umber-ash hover:text-umber-cream absolute right-0 bottom-1.5 rounded-full px-2 py-1 text-xs font-medium tracking-[0.06em] uppercase transition-colors"
          >
            <span data-label>Mostrar</span>
            <span class="sr-only"> la contraseña</span>
          </button>
        </div>
        {field.help !== null && (
          <p id={`${field.name}-help`} class={helpClass}>
            {field.help}
          </p>
        )}
        {field.name === 'password_confirm' && (
          <p data-password-match aria-live="polite" hidden class="text-umber-amber text-xs data-[state=mismatch]:text-red-300" />
        )}
        {errorFor(field.name) !== null && (
          <p id={`${field.name}-error`} role="alert" class={errorClass}>
            {errorFor(field.name)}
          </p>
        )}
      </div>
    ))
  }

  <div class="pt-3">
    <button type="submit" class="btn-primary w-full py-3.5 text-[0.95rem]">
      {signup ? 'Crear cuenta' : 'Entrar'} <span class="arrow" aria-hidden="true">→</span>
    </button>
  </div>
</form>

<div class="mt-8 flex items-center gap-3" aria-hidden="true">
  <span class="bg-umber-line h-px flex-1" />
  <span class="text-umber-ash text-xs">o</span>
  <span class="bg-umber-line h-px flex-1" />
</div>

<a href={`/auth/google?next=${encodeURIComponent(next)}`} class="btn-secondary mt-6 w-full py-3.5 text-[0.95rem]">
  <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true">
    <path fill="#4285F4" d="M44.5 20H24v8.5h11.8C34.7 33.9 30 37 24 37c-7.2 0-13-5.8-13-13s5.8-13 13-13c3.3 0 6.3 1.2 8.6 3.2l6-6C34.6 4.1 29.6 2 24 2 11.8 2 2 11.8 2 24s9.8 22 22 22c11 0 21-8 21-22 0-1.3-.1-2.7-.5-4z" />
  </svg>
  {signup ? 'Crear cuenta con Google' : 'Seguir con Google'}
</a>

<script>
  import { initAuthForms } from '@/scripts/auth-form';

  initAuthForms();
</script>
