---
/**
 * Pantalla de cuenta (entrar, registrarse): el formulario a un lado y, en
 * pantallas anchas, un fotograma al otro, que se abre como un proyector. En el
 * móvil, el fotograma es una franja estrecha encima del formulario.
 */
import { pickStill } from '@/lib/showcase';
import { backdropUrl } from '@/lib/tmdb';

const still = await pickStill();
const caption = still === null ? null : [still.title, still.year].filter((part) => part !== null).join(', ');
const hasStill = still !== null && still.backdrop_path !== null;
---

<main class="mx-auto grid w-full max-w-[80rem] flex-1 grid-cols-1 gap-x-16 px-5 pb-16 sm:px-8 lg:grid-cols-12 lg:pt-10">
  {
    hasStill && (
      <figure class="-mx-5 sm:-mx-8 lg:col-span-6 lg:mx-0" aria-hidden="true">
        <div class="shutter h-40 sm:h-56 lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:aspect-[4/5] lg:h-auto lg:rounded-[4px]">
          <img
            src={backdropUrl(still.backdrop_path, 'w1280')}
            srcset={`${backdropUrl(still.backdrop_path, 'w780')} 780w, ${backdropUrl(still.backdrop_path, 'w1280')} 1280w`}
            sizes="(min-width: 1024px) 45vw, 100vw"
            alt=""
            class="graded develop h-full w-full object-cover"
          />
          <div class="vignette absolute inset-0" />
          {/* En el móvil se funde con la página; en escritorio, oscuro abajo para el pie de foto. */}
          <div class="from-umber-base absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t to-transparent lg:hidden" />
          <div class="absolute inset-x-0 bottom-0 hidden h-1/2 bg-gradient-to-t from-black/85 to-transparent lg:block" />
          <figcaption class="screen absolute inset-x-7 bottom-6 hidden flex-wrap items-baseline justify-between gap-x-4 lg:flex">
            <span class="eyebrow">En pantalla</span>
            <span class="font-display text-umber-ink/90 text-lg font-semibold tracking-[-0.02em]">{caption}</span>
          </figcaption>
        </div>
      </figure>
    )
  }
  <div
    class:list={[
      'relative w-full',
      hasStill
        ? '-mt-6 mx-auto max-w-md sm:-mt-10 lg:col-span-5 lg:col-start-8 lg:mx-0 lg:mt-0 lg:max-w-none lg:pt-14'
        : 'mx-auto max-w-md pt-10 lg:col-span-12',
    ]}
  >
    <slot />
  </div>
</main>
